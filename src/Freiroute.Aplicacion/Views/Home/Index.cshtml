@using Freiroute.Aplicacion.Helpers
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveMenu"] = "dashboard";

    var nombre = User.FindFirstValue("nombre") ?? "Usuario";
    var tenant = ViewData["TenantNombre"]?.ToString() ?? "Mi empresa";
    var fechaHoy = DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));
}

<!-- Page header -->
<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Bienvenido, @nombre</h1>
        <p class="fr-page-subtitle">@tenant · @fechaHoy</p>
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- KPI Cards (placeholders — datos reales en Sprint 7) -->
    <div class="fr-kpi-grid">
        <div class="fr-kpi-card">
            <div class="fr-kpi-label">Embarques hoy</div>
            <div class="fr-kpi-value kpi-blue">--</div>
            <div class="fr-kpi-delta" style="color:var(--fr-text-muted)">Disponible en Sprint 7</div>
        </div>
        <div class="fr-kpi-card">
            <div class="fr-kpi-label">OTD del mes</div>
            <div class="fr-kpi-value kpi-green">--</div>
            <div class="fr-kpi-delta" style="color:var(--fr-text-muted)">Disponible en Sprint 7</div>
        </div>
        <div class="fr-kpi-card">
            <div class="fr-kpi-label">En tránsito</div>
            <div class="fr-kpi-value kpi-amber">--</div>
            <div class="fr-kpi-delta" style="color:var(--fr-text-muted)">Disponible en Sprint 7</div>
        </div>
        <div class="fr-kpi-card">
            <div class="fr-kpi-label">Carriers activos</div>
            <div class="fr-kpi-value">--</div>
            <div class="fr-kpi-delta" style="color:var(--fr-text-muted)">Disponible en Sprint 7</div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Módulos disponibles -->
        <div class="col-lg-7">
            <div class="fr-card h-100">
                <div class="fr-card-header">
                    <span class="fr-card-title">Módulos disponibles</span>
                </div>
                <div class="fr-card-body">
                    <div class="row g-3">
                        @if (User.HasPermission("ordenes", "READ"))
                        {
                            <div class="col-md-6">
                                <a href="/ordenes" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-clipboard-list" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Órdenes</span>
                                </a>
                            </div>
                        }
                        @if (User.HasPermission("embarques", "READ"))
                        {
                            <div class="col-md-6">
                                <a href="/embarques" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-truck" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Embarques</span>
                                </a>
                            </div>
                        }
                        @if (User.HasPermission("carriers", "READ"))
                        {
                            <div class="col-md-6">
                                <a href="/carriers" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-building-warehouse" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Carriers</span>
                                </a>
                            </div>
                        }
                        @if (User.HasPermission("rutas", "READ"))
                        {
                            <div class="col-md-6">
                                <a href="/rutas" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-map-route" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Rutas</span>
                                </a>
                            </div>
                        }
                        @if (User.HasPermission("track_trace", "READ"))
                        {
                            <div class="col-md-6">
                                <a href="/track-trace" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-map-pin" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Track &amp; Trace</span>
                                </a>
                            </div>
                        }
                        @if (User.IsInRole("SUPER_ADMIN") || User.IsInRole("ADMIN"))
                        {
                            <div class="col-md-6">
                                <a asp-area="Admin" asp-controller="Usuarios" asp-action="Index" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-users" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Usuarios</span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a asp-area="Admin" asp-controller="Perfiles" asp-action="Index" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-user-shield" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Perfiles y Permisos</span>
                                </a>
                            </div>
                        }
                        @if (User.IsInRole("SUPER_ADMIN"))
                        {
                            <div class="col-md-6">
                                <a asp-area="Admin" asp-controller="Empresas" asp-action="Index" class="fr-btn fr-btn-ghost w-100 justify-content-start" style="padding:16px;text-decoration:none">
                                    <i class="ti ti-building" style="font-size:20px;color:var(--fr-action-blue);margin-right:8px"></i>
                                    <span>Empresas</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Actividad reciente -->
        <div class="col-lg-5">
            <div class="fr-card h-100">
                <div class="fr-card-header">
                    <span class="fr-card-title">Actividad reciente</span>
                </div>
                <div class="fr-card-body" style="padding:0">
                    <!-- Sin datos por ahora — la auditoría llegará en Sprint 8 -->
                    <div class="fr-empty py-4">
                        <div class="fr-empty-icon"><i class="ti ti-activity"></i></div>
                        <div class="fr-empty-title">Sin actividad reciente</div>
                        <div class="fr-empty-text">Las acciones del sistema aparecerán aquí.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="fr-card fr-card-info" style="max-width:560px;margin:auto">
        <div class="fr-card-body text-center" style="padding:48px 24px">
            <div class="fr-empty-icon"><i class="ti ti-lock"></i></div>
            <div class="fr-empty-title">Inicie sesión para continuar</div>
            <div class="fr-empty-text">Necesita autenticarse para acceder a los módulos de la plataforma.</div>
            <a asp-area="Auth" asp-controller="Account" asp-action="Login" class="fr-btn fr-btn-primary mt-4">
                <i class="ti ti-login"></i> Iniciar sesión
            </a>
        </div>
    </div>
}