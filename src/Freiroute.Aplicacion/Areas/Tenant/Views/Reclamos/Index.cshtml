@using Freiroute.Aplicacion.Areas.Tenant.ViewModels
@using Freiroute.Utility.Constants
@model ReclamoIndexViewModel
@{
    ViewData["Title"] = "Reclamos";
    ViewData["ActiveMenu"] = "reclamos";
    string PageUrl(int p) => Url.Action("Index", new
    {
        estado = Model.Filtro?.Estado,
        tipo = Model.Filtro?.Tipo,
        desde = Model.Filtro?.Desde?.ToString("yyyy-MM-dd"),
        hasta = Model.Filtro?.Hasta?.ToString("yyyy-MM-dd"),
        page = p
    })!;
}

<nav class="fr-breadcrumb" aria-label="Breadcrumb">
    <span>Operación</span>
    <span class="fr-breadcrumb-sep">/</span>
    <span aria-current="page">Reclamos</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Reclamos</h1>
        <div class="fr-page-subtitle">Reclamos formales de clientes por daño, pérdida o retraso (HU-032)</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (User.HasPermission("ordenes", "CREATE"))
        {
            <a asp-area="Tenant" asp-controller="Reclamos" asp-action="Crear" class="fr-btn fr-btn-primary">
                <i class="ti ti-plus"></i> Nuevo reclamo
            </a>
        }
    </div>
</div>

<div class="fr-card mb-3">
    <div class="fr-card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="fr-form-label" for="fEstadoReclamo">Estado</label>
                <select id="fEstadoReclamo" name="estado" class="fr-form-control">
                    <option value="">Todos los estados</option>
                    <option value="ABIERTO" selected="@(Model.Filtro?.Estado == "ABIERTO")">Abierto</option>
                    <option value="EN_REVISION" selected="@(Model.Filtro?.Estado == "EN_REVISION")">En revisión</option>
                    <option value="APROBADO" selected="@(Model.Filtro?.Estado == "APROBADO")">Aprobado</option>
                    <option value="RECHAZADO" selected="@(Model.Filtro?.Estado == "RECHAZADO")">Rechazado</option>
                    <option value="CERRADO" selected="@(Model.Filtro?.Estado == "CERRADO")">Cerrado</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="fr-form-label" for="fTipoReclamo">Tipo</label>
                <select id="fTipoReclamo" name="tipo" class="fr-form-control">
                    <option value="">Todos los tipos</option>
                    <option value="DANO" selected="@(Model.Filtro?.Tipo == "DANO")">Daño</option>
                    <option value="PERDIDA" selected="@(Model.Filtro?.Tipo == "PERDIDA")">Pérdida</option>
                    <option value="RETRASO" selected="@(Model.Filtro?.Tipo == "RETRASO")">Retraso</option>
                    <option value="OTRO" selected="@(Model.Filtro?.Tipo == "OTRO")">Otro</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="fr-form-label" for="fDesde">Desde</label>
                <input id="fDesde" type="date" name="desde" value="@(Model.Filtro?.Desde?.ToString("yyyy-MM-dd"))" class="fr-form-control"
                       aria-label="Fecha de creación desde" />
            </div>
            <div class="col-md-2">
                <label class="fr-form-label" for="fHasta">Hasta</label>
                <input id="fHasta" type="date" name="hasta" value="@(Model.Filtro?.Hasta?.ToString("yyyy-MM-dd"))" class="fr-form-control"
                       aria-label="Fecha de creación hasta" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="fr-btn fr-btn-primary w-100">
                    <i class="ti ti-filter"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="fr-table-wrapper">
    <div class="fr-table-responsive">
        <table class="fr-table">
            <thead>
                <tr>
                    <th>N° Reclamo</th>
                    <th>Orden</th>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count() == 0)
                {
                    <tr>
                        <td colspan="8">
                            <div class="fr-empty">
                                <div class="fr-empty-icon"><i class="ti ti-report"></i></div>
                                <div class="fr-empty-title">No hay reclamos</div>
                                <div class="fr-empty-text">Registre el primer reclamo o ajuste los filtros de búsqueda.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td><span class="fr-id-code">@(string.IsNullOrEmpty(r.NumeroReclamo) ? "—" : r.NumeroReclamo)</span></td>
                        <td><span class="fr-id-code">@r.OrdenNumero</span></td>
                        <td class="fw-semibold">@r.ClienteNombre</td>
                        <td>
                            <span class="fr-badge fr-badge-neutral">@r.Tipo</span>
                        </td>
                        <td>@(r.MontoReclamado?.ToString("N2") ?? "—")</td>
                        <td>@await Html.PartialAsync("_BadgeEstadoReclamo", r.Estado)</td>
                        <td>@r.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-area="Tenant" asp-controller="Reclamos" asp-action="Detalle" asp-route-id="@r.Id"
                               class="fr-btn fr-btn-ghost fr-btn-sm" title="Ver detalle"
                               aria-label="Ver detalle del reclamo @(r.NumeroReclamo ?? r.Id.ToString())">
                                <i class="ti ti-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Paginacion", new PaginacionModel
    {
        PaginaActual = Model.Page,
        PageSize = Model.PageSize,
        TotalItems = Model.Total,
        ItemsEnPagina = Model.Items.Count(),
        PageUrl = PageUrl,
    })
</div>

@section Scripts {
<script>
    // ── Toast de TempData (server-side) ──────────────────────────
    const frToastMsg = '@(TempData["FrToast"]?.ToString() ?? "")';
    const frToastTipo = '@(TempData["FrToastTipo"]?.ToString() ?? "success")';
    if (frToastMsg) FrToast.show(frToastMsg, frToastTipo);
</script>
}