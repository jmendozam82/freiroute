@model Freiroute.DTO.Mercancia.TipoMercanciaRequestDto
@{
    ViewData["Title"] = "Nueva mercancía";
    ViewData["ActiveMenu"] = "mercancia";
}

<nav class="fr-breadcrumb" aria-label="Breadcrumb">
    <a asp-area="Tenant" asp-controller="Mercancia" asp-action="Index">Tipos de mercancía</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span aria-current="page">Nueva mercancía</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Nueva mercancía</h1>
        <div class="fr-page-subtitle">Si es HAZMAT, la clase ONU activa alertas en embarques y documentos</div>
    </div>
</div>

<div class="fr-card">
    <div class="fr-card-body">
        <form id="frMercanciaForm" novalidate>
            <div class="form-section-title">Identificación</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="inputNombre" class="fr-form-label fr-form-required">Nombre</label>
                    <input type="text" id="inputNombre" class="fr-form-control" placeholder="Ej: Aceite vegetal"
                           data-val="true" data-val-required="El nombre es obligatorio"
                           data-val-maxlength="Máximo 150 caracteres" data-val-maxlength-max="150" />
                    <span class="fr-form-error" data-valmsg-for="inputNombre"></span>
                </div>
                <div class="col-md-2">
                    <label for="inputCodigo" class="fr-form-label">Código</label>
                    <input type="text" id="inputCodigo" class="fr-form-control" placeholder="Ej: ACE-01"
                           data-val-maxlength="Máximo 30 caracteres" data-val-maxlength-max="30" />
                    <span class="fr-form-error" data-valmsg-for="inputCodigo"></span>
                </div>
                <div class="col-md-3">
                    <label for="inputCategoria" class="fr-form-label">Categoría</label>
                    <input type="text" id="inputCategoria" class="fr-form-control" placeholder="Alimentos, construcción..." />
                </div>
                <div class="col-md-3">
                    <label for="inputCodigoHs" class="fr-form-label">Código HS (aduana)</label>
                    <input type="text" id="inputCodigoHs" class="fr-form-control" placeholder="Ej: 1512.19" maxlength="12" />
                </div>
                <div class="col-12">
                    <label for="inputDescripcion" class="fr-form-label">Descripción</label>
                    <input type="text" id="inputDescripcion" class="fr-form-control" placeholder="Descripción opcional" />
                </div>
            </div>

            <div class="form-section-title mt-4">
                Clasificación de peligrosidad (HAZMAT)
                <span class="fr-form-hint ms-2">Opcional salvo que la mercancía sea peligrosa</span>
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="selectClasePeligrosidad" class="fr-form-label">Clase ONU</label>
                    <select id="selectClasePeligrosidad" class="fr-form-control">
                        <option value="">— No peligrosa —</option>
                        <option value="1.1">1.1 Explosivos</option>
                        <option value="1.2">1.2 Explosivos</option>
                        <option value="1.3">1.3 Explosivos</option>
                        <option value="2.1">2.1 Gases inflamables</option>
                        <option value="2.2">2.2 Gases no inflamables</option>
                        <option value="2.3">2.3 Gases tóxicos</option>
                        <option value="3">3 Líquidos inflamables</option>
                        <option value="4.1">4.1 Sólidos inflamables</option>
                        <option value="4.2">4.2 Combustión espontánea</option>
                        <option value="4.3">4.3 Peligro húmedo</option>
                        <option value="5.1">5.1 Oxidantes</option>
                        <option value="5.2">5.2 Peróxidos orgánicos</option>
                        <option value="6.1">6.1 Tóxicos</option>
                        <option value="6.2">6.2 Infecciosos</option>
                        <option value="7">7 Radiactivos</option>
                        <option value="8">8 Corrosivos</option>
                        <option value="9">9 Misceláneos</option>
                    </select>
                </div>
                <div class="col-md-3 d-none" id="bloqueCodigoOnu">
                    <label for="inputCodigoOnu" class="fr-form-label">Código ONU</label>
                    <input type="text" id="inputCodigoOnu" class="fr-form-control" placeholder="Ej: UN1202" />
                </div>
                <div class="col-12 d-none" id="bloqueHazmatHint">
                    <span class="fr-badge fr-badge-danger d-inline-flex align-items-center gap-1">
                        <i class="ti ti-alert-triangle"></i> Se marcará como HAZMAT en embarques y documentos
                    </span>
                </div>
            </div>

            <div class="form-section-title mt-4">Requisitos de manejo</div>
            <div class="row g-3">
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-4">
                        <label class="fr-form-label d-inline-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" id="chkRefrigeracion" class="fr-check" />
                            <span>Requiere cadena de frío</span>
                        </label>
                        <label class="fr-form-label d-inline-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" id="chkFragil" class="fr-check" />
                            <span>Frágil</span>
                        </label>
                        <label class="fr-form-label d-inline-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" id="chkPerecedero" class="fr-check" />
                            <span>Perecedera</span>
                        </label>
                        <label class="fr-form-label d-inline-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" id="chkSobredimensionado" class="fr-check" />
                            <span>Sobredimensionada</span>
                        </label>
                        <label class="fr-form-label d-inline-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" id="chkFumigacion" class="fr-check" />
                            <span>Requiere fumigación</span>
                        </label>
                    </div>
                </div>

                <div class="col-md-3 d-none" id="bloqueTemps">
                    <label for="inputTempMin" class="fr-form-label fr-form-required">Temperatura mínima °C</label>
                    <input type="number" id="inputTempMin" step="0.1" class="fr-form-control" placeholder="Ej: 2" />
                </div>
                <div class="col-md-3 d-none" id="bloqueTempsMax">
                    <label for="inputTempMax" class="fr-form-label fr-form-required">Temperatura máxima °C</label>
                    <input type="number" id="inputTempMax" step="0.1" class="fr-form-control" placeholder="Ej: 8" />
                </div>
                <div class="col-md-3">
                    <label for="inputPesoMax" class="fr-form-label">Peso máx. por unidad (kg)</label>
                    <input type="number" id="inputPesoMax" min="0" step="any" class="fr-form-control" placeholder="Opcional" />
                </div>
                <div class="col-md-3">
                    <label for="inputVolumenMax" class="fr-form-label">Volumen máx. por unidad (m³)</label>
                    <input type="number" id="inputVolumenMax" min="0" step="any" class="fr-form-control" placeholder="Opcional" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="fr-btn fr-btn-primary" id="btnGuardar">
                    <i class="ti ti-device-floppy"></i> Guardar
                </button>
                <a asp-area="Tenant" asp-controller="Mercancia" asp-action="Index" class="fr-btn fr-btn-ghost">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    $.validator.unobtrusive.parse('#frMercanciaForm');

    const claseSelect = document.getElementById('selectClasePeligrosidad');
    const chkRefri = document.getElementById('chkRefrigeracion');

    claseSelect.addEventListener('change', () => {
        const hazmat = claseSelect.value !== '';
        document.getElementById('bloqueCodigoOnu').classList.toggle('d-none', !hazmat);
        document.getElementById('bloqueHazmatHint').classList.toggle('d-none', !hazmat);
    });

    chkRefri.addEventListener('change', () => {
        const activo = chkRefri.checked;
        document.getElementById('bloqueTemps').classList.toggle('d-none', !activo);
        document.getElementById('bloqueTempsMax').classList.toggle('d-none', !activo);
    });

    document.getElementById('frMercanciaForm').addEventListener('submit', async e => {
        e.preventDefault();
        if (!$('#frMercanciaForm').valid()) return;

        const clase = claseSelect.value;
        const requiereRefri = chkRefri.checked;

        // Validación condicional: temperaturas si cadena de frío
        if (requiereRefri) {
            const tMin = document.getElementById('inputTempMin').value;
            const tMax = document.getElementById('inputTempMax').value;
            if (!tMin || !tMax) {
                FrToast.error('Defina las temperaturas mínima y máxima para cadena de frío');
                return;
            }
        }

        const payload = {
            nombre: document.getElementById('inputNombre').value.trim(),
            codigo: document.getElementById('inputCodigo').value.trim() || null,
            descripcion: document.getElementById('inputDescripcion').value.trim() || null,
            categoria: document.getElementById('inputCategoria').value.trim() || null,
            clasePeligrosidad: clase || null,
            codigoOnu: clase ? (document.getElementById('inputCodigoOnu').value.trim() || null) : null,
            codigoHs: document.getElementById('inputCodigoHs').value.trim() || null,
            pesoMaximoKg: parseFloat(document.getElementById('inputPesoMax').value) || null,
            volumenMaximoM3: parseFloat(document.getElementById('inputVolumenMax').value) || null,
            temperaturaMinC: requiereRefri ? (parseFloat(document.getElementById('inputTempMin').value) || null) : null,
            temperaturaMaxC: requiereRefri ? (parseFloat(document.getElementById('inputTempMax').value) || null) : null,
            requiereRefrigeracion: requiereRefri,
            esFragil: document.getElementById('chkFragil').checked,
            esPerecedero: document.getElementById('chkPerecedero').checked,
            esSobredimensionado: document.getElementById('chkSobredimensionado').checked,
            requiereFumigacion: document.getElementById('chkFumigacion').checked
        };

        const resp = await FrApi.post('/api/tipos-mercancia', payload);
        FrApi.handleResponse(resp, () => {
            FrToast.success('Mercancía creada correctamente');
            setTimeout(() => window.location.href = '/Tenant/Mercancia', 600);
        });
    });
</script>
}