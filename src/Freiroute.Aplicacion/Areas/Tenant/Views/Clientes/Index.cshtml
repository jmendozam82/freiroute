@using Freiroute.DTO.Cliente
@using Freiroute.Utility.Pagination
@model PagedResult<ClienteResponseDto>
@{
    ViewData["Title"] = "Clientes";
    ViewData["ActiveMenu"] = "clientes";
    var filtroTipo = ViewData["FiltroTipo"] as string;
    var filtroEstado = ViewData["FiltroEstado"] as string;
    var busqueda = ViewData["Busqueda"] as string;
    string PageUrl(int p) => Url.Action("Index", new { tipoCliente = filtroTipo, estadoCredito = filtroEstado, q = busqueda, page = p })!;
}

<nav class="fr-breadcrumb" aria-label="Breadcrumb">
    <span>Catálogos</span>
    <span class="fr-breadcrumb-sep">/</span>
    <span aria-current="page">Clientes</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Clientes</h1>
        <div class="fr-page-subtitle">Empresas que contratan transporte, con estado de crédito y SLA pactado</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a asp-area="Tenant" asp-controller="Clientes" asp-action="Create" class="fr-btn fr-btn-primary">
            <i class="ti ti-plus"></i> Nuevo cliente
        </a>
    </div>
</div>

<div class="fr-kpi-grid">
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Clientes registrados</div>
        <div class="fr-kpi-value kpi-blue">@Model.TotalItems</div>
        <div class="fr-kpi-delta up">@Model.PageSize por página</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Crédito bloqueado (esta página)</div>
        <div class="fr-kpi-value kpi-red">@Model.Items.Count(c => c.EstadoCredito == "BLOQUEADO")</div>
        <div class="fr-kpi-delta down">Bloqueados no pueden emitir embarques</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">En mora (esta página)</div>
        <div class="fr-kpi-value kpi-amber">@Model.Items.Count(c => c.EstadoCredito == "EN_MORA")</div>
        <div class="fr-kpi-delta down">Alertar antes de asignar despacho</div>
    </div>
</div>

<div class="fr-card mb-3">
    <div class="fr-card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="fr-form-label" for="fTipoCliente">Tipo</label>
                <select id="fTipoCliente" name="tipoCliente" class="fr-form-control">
                    <option value="">Todos los tipos</option>
                    <option value="VIP" selected="@(filtroTipo == "VIP")">VIP</option>
                    <option value="CORPORATIVO" selected="@(filtroTipo == "CORPORATIVO")">Corporativo</option>
                    <option value="GOBIERNO" selected="@(filtroTipo == "GOBIERNO")">Gobierno</option>
                    <option value="REGULAR" selected="@(filtroTipo == "REGULAR")">Regular</option>
                    <option value="OCASIONAL" selected="@(filtroTipo == "OCASIONAL")">Ocasional</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="fr-form-label" for="fEstadoCredito">Estado de crédito</label>
                <select id="fEstadoCredito" name="estadoCredito" class="fr-form-control">
                    <option value="">Todos los estados</option>
                    <option value="AL_DIA" selected="@(filtroEstado == "AL_DIA")">Al día</option>
                    <option value="EN_MORA" selected="@(filtroEstado == "EN_MORA")">En mora</option>
                    <option value="BLOQUEADO" selected="@(filtroEstado == "BLOQUEADO")">Bloqueado</option>
                    <option value="SIN_CREDITO" selected="@(filtroEstado == "SIN_CREDITO")">Sin crédito</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="fr-form-label" for="fBusqueda">Buscar</label>
                <input id="fBusqueda" type="text" name="q" value="@busqueda" class="fr-form-control"
                       placeholder="Nombre, RUC o ciudad" aria-label="Buscar cliente" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="fr-btn fr-btn-primary w-100">
                    <i class="ti ti-filter"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="fr-table-wrapper">
    <div class="fr-table-responsive">
        <table class="fr-table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>RUC/NIT</th>
                    <th>Tipo</th>
                    <th>Crédito</th>
                    <th>Despacho por defecto</th>
                    <th>SLA</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count() == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="fr-empty">
                                <div class="fr-empty-icon"><i class="ti ti-building-store"></i></div>
                                <div class="fr-empty-title">No hay clientes</div>
                                <div class="fr-empty-text">Cree el primer cliente o importe el listado desde el detalle.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@c.Nombre</div>
                            @if (!string.IsNullOrEmpty(c.NombreComercial) && c.NombreComercial != c.Nombre)
                            {
                                <div class="text-muted">@c.NombreComercial</div>
                            }
                        </td>
                        <td><span class="fr-id-code">@(string.IsNullOrEmpty(c.RucNit) ? "—" : c.RucNit)</span></td>
                        <td><span class="fr-badge @FrBadges.TipoCliente(c.TipoCliente)">@c.TipoClienteLabel</span></td>
                        <td>
                            <span class="fr-badge @FrBadges.EstadoCredito(c.EstadoCredito)">@c.EstadoCreditoLabel</span>
                            @if (c.EstadoCredito == "BLOQUEADO")
                            {
                                <div class="text-muted mt-1">Límite: @c.Moneda @c.LimiteCredito.ToString("N0") · @c.CreditoDias días</div>
                            }
                        </td>
                        <td>
                            @if (c.UbicacionDefectoId.HasValue)
                            {
                                <span class="text-muted">@c.UbicacionDefectoNombre</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (c.SlaDiasEntrega.HasValue)
                            {
                                <span class="fr-badge fr-badge-info">@c.SlaDiasEntrega días</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-area="Tenant" asp-controller="Clientes" asp-action="Detalle" asp-route-id="@c.Id" class="fr-btn fr-btn-ghost fr-btn-sm"
                                   title="Ver detalle" aria-label="Ver detalle de @c.Nombre">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a asp-area="Tenant" asp-controller="Clientes" asp-action="Edit" asp-route-id="@c.Id" class="fr-btn fr-btn-ghost fr-btn-sm"
                                   title="Editar" aria-label="Editar @c.Nombre">
                                    <i class="ti ti-edit"></i>
                                </a>
                                <button type="button" class="fr-btn fr-btn-danger fr-btn-sm"
                                        data-fr-deactivate="/api/clientes/@c.Id/deactivate"
                                        data-fr-nombre="@c.Nombre"
                                        title="Desactivar" aria-label="Desactivar @c.Nombre">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="fr-pagination">
        <span class="fr-pagination-info">
            Mostrando @(Model.Items.Count() == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1)–
            @((Model.PageNumber - 1) * Model.PageSize + Model.Items.Count()) de @Model.TotalItems
        </span>
        <div class="d-flex gap-2">
            @if (Model.HasPreviousPage)
            {
                <a class="fr-page-btn" href="@PageUrl(Model.PageNumber - 1)">Anterior</a>
            }
            else
            {
                <button type="button" class="fr-page-btn" disabled>Anterior</button>
            }
            @if (Model.HasNextPage)
            {
                <a class="fr-page-btn" href="@PageUrl(Model.PageNumber + 1)">Siguiente</a>
            }
            else
            {
                <button type="button" class="fr-page-btn" disabled>Siguiente</button>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Toast de TempData (server-side create/edit) ─────────────
    const frToastMsg = '@(TempData["FrToast"]?.ToString() ?? "")';
    const frToastTipo = '@(TempData["FrToastTipo"]?.ToString() ?? "success")';
    if (frToastMsg) FrToast.show(frToastMsg, frToastTipo);
</script>
}