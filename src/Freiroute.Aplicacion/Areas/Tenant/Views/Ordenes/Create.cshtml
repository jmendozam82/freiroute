@using Freiroute.Aplicacion.Areas.Tenant.ViewModels
@using Freiroute.Utility.Constants
@model OrdenFormViewModel
@{
    ViewData["Title"] = "Nueva orden";
    ViewData["ActiveMenu"] = "ordenes";
}

<nav class="fr-breadcrumb" aria-label="Breadcrumb">
    <a asp-area="Tenant" asp-controller="Ordenes" asp-action="Index">Órdenes</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span aria-current="page">Nueva orden</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Nueva orden</h1>
        <div class="fr-page-subtitle">Registre la solicitud de transporte. Se guarda como borrador hasta confirmarla (HU-021)</div>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="fr-btn fr-btn-secondary" id="btnUsarPlantilla" title="Crear orden desde plantilla (HU-027)">
            <i class="ti ti-template"></i> Usar plantilla
        </button>
    </div>
</div>

<form id="frOrdenForm" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="fr-form-error mb-3"></div>

    <!-- ── Cliente y ruta ─────────────────────────────────────── -->
    <div class="fr-card mb-4">
        <div class="fr-card-header">
            <div class="fr-card-title">Cliente y ruta</div>
        </div>
        <div class="fr-card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="ClienteId" class="fr-form-label fr-form-required"></label>
                    <select asp-for="ClienteId" asp-items="Model.Clientes" class="fr-form-control">
                        <option value="">Seleccione un cliente</option>
                    </select>
                    <span asp-validation-for="ClienteId" class="fr-form-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OrigenId" class="fr-form-label fr-form-required"></label>
                    <select asp-for="OrigenId" asp-items="Model.Ubicaciones" class="fr-form-control">
                        <option value="">Seleccione el origen</option>
                    </select>
                    <span asp-validation-for="OrigenId" class="fr-form-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DestinoId" class="fr-form-label fr-form-required"></label>
                    <select asp-for="DestinoId" asp-items="Model.Ubicaciones" class="fr-form-control">
                        <option value="">Seleccione el destino</option>
                    </select>
                    <span asp-validation-for="DestinoId" class="fr-form-error"></span>
                </div>
                <div class="col-12">
                    <div id="alertaRutaIgual" class="d-none">
                        <span class="fr-badge fr-badge-warning"><i class="ti ti-alert-triangle"></i> El origen y el destino no pueden ser la misma ubicación</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Mercancía ──────────────────────────────────────────── -->
    <div class="fr-card mb-4">
        <div class="fr-card-header">
            <div class="fr-card-title">Mercancía</div>
        </div>
        <div class="fr-card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="TipoMercanciaId" class="fr-form-label fr-form-required"></label>
                    <select asp-for="TipoMercanciaId" asp-items="Model.TiposMercancia" class="fr-form-control">
                        <option value="">Seleccione el tipo</option>
                    </select>
                    <span asp-validation-for="TipoMercanciaId" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="UnidadMedidaId" class="fr-form-label fr-form-required"></label>
                    <select asp-for="UnidadMedidaId" asp-items="Model.Unidades" class="fr-form-control">
                        <option value="">Seleccione la unidad</option>
                    </select>
                    <span asp-validation-for="UnidadMedidaId" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TipoEmbalajeId" class="fr-form-label"></label>
                    <select asp-for="TipoEmbalajeId" asp-items="Model.Embalajes" class="fr-form-control">
                        <option value="">Sin embalaje</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Datos físicos ──────────────────────────────────────── -->
    <div class="fr-card mb-4">
        <div class="fr-card-header">
            <div class="fr-card-title">Datos físicos</div>
        </div>
        <div class="fr-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Cantidad" class="fr-form-label fr-form-required"></label>
                    <input asp-for="Cantidad" type="number" step="any" min="0.01" class="fr-form-control"
                           placeholder="0" aria-label="Cantidad de unidades" />
                    <span asp-validation-for="Cantidad" class="fr-form-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="PesoKg" class="fr-form-label fr-form-required"></label>
                    <input asp-for="PesoKg" type="number" step="any" min="0.01" class="fr-form-control"
                           placeholder="0.00" aria-label="Peso total en kilogramos" />
                    <small class="form-text text-muted">Peso total en kg</small>
                    <span asp-validation-for="PesoKg" class="fr-form-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VolumenM3" class="fr-form-label"></label>
                    <input asp-for="VolumenM3" type="number" step="any" min="0.01" class="fr-form-control"
                           placeholder="Opcional" aria-label="Volumen total en metros cúbicos" />
                    <small class="form-text text-muted">Volumen en m³</small>
                    <span asp-validation-for="VolumenM3" class="fr-form-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ValorDeclarado" class="fr-form-label"></label>
                    <input asp-for="ValorDeclarado" type="number" step="any" min="0" class="fr-form-control"
                           placeholder="Opcional" aria-label="Valor declarado de la mercancía" />
                    <small class="form-text text-muted">Valor declarado</small>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Datos del servicio ─────────────────────────────────── -->
    <div class="fr-card mb-4">
        <div class="fr-card-header">
            <div class="fr-card-title">Datos del servicio</div>
        </div>
        <div class="fr-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="ModoTransporte" class="fr-form-label fr-form-required"></label>
                    <select asp-for="ModoTransporte" class="fr-form-control">
                        <option value="TERRESTRE">Terrestre</option>
                        <option value="AEREO">Aéreo</option>
                        <option value="MARITIMO">Marítimo</option>
                        <option value="FERROVIARIO">Ferroviario</option>
                        <option value="INTERMODAL">Intermodal</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="NivelServicio" class="fr-form-label"></label>
                    <select asp-for="NivelServicio" class="fr-form-control">
                        @foreach (var kv in NivelServicio.Labels)
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Prioridad" class="fr-form-label"></label>
                    <select asp-for="Prioridad" class="fr-form-control">
                        @foreach (var kv in OrdenPrioridad.Labels)
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="TarifaId" class="fr-form-label"></label>
                    <select asp-for="TarifaId" asp-items="Model.Tarifas" class="fr-form-control">
                        <option value="">Sin tarifa</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Fechas y referencia ────────────────────────────────── -->
    <div class="fr-card mb-4">
        <div class="fr-card-header">
            <div class="fr-card-title">Fechas y referencia</div>
        </div>
        <div class="fr-card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FechaPickupSolicitada" class="fr-form-label"></label>
                    <input asp-for="FechaPickupSolicitada" type="date" class="fr-form-control" aria-label="Fecha de recogida solicitada" />
                    <span asp-validation-for="FechaPickupSolicitada" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaEntregaRequerida" class="fr-form-label"></label>
                    <input asp-for="FechaEntregaRequerida" type="date" class="fr-form-control" aria-label="Fecha de entrega requerida" />
                    <span asp-validation-for="FechaEntregaRequerida" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ReferenciaCliente" class="fr-form-label"></label>
                    <input asp-for="ReferenciaCliente" maxlength="100" class="fr-form-control"
                           placeholder="Referencia interna del cliente" aria-label="Referencia del cliente" />
                    <span asp-validation-for="ReferenciaCliente" class="fr-form-error"></span>
                </div>
                <div class="col-12">
                    <div id="alertaFechas" class="d-none">
                        <span class="fr-badge fr-badge-warning"><i class="ti ti-alert-triangle"></i> La fecha de entrega debe ser posterior a la fecha de recogida</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="NumeroPo" class="fr-form-label"></label>
                    <input asp-for="NumeroPo" maxlength="100" class="fr-form-control fr-id-code"
                           placeholder="Purchase Order del cliente (ej: PO-000123)" aria-label="Número de Purchase Order" />
                    <small class="form-text text-muted">Trazabilidad con el ERP/WMS del cliente</small>
                    <span asp-validation-for="NumeroPo" class="fr-form-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NumeroSo" class="fr-form-label"></label>
                    <input asp-for="NumeroSo" maxlength="100" class="fr-form-control fr-id-code"
                           placeholder="Sales Order del cliente (opcional)" aria-label="Número de Sales Order" />
                    <span asp-validation-for="NumeroSo" class="fr-form-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Instrucciones" class="fr-form-label"></label>
                    <textarea asp-for="Instrucciones" maxlength="1000" rows="3" class="fr-form-control"
                              placeholder="Instrucciones especiales de manejo (opcional)" aria-label="Instrucciones especiales"></textarea>
                    <span asp-validation-for="Instrucciones" class="fr-form-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid var(--fr-border)">
        <button type="submit" class="fr-btn fr-btn-primary">
            <i class="ti ti-device-floppy"></i> Guardar borrador
        </button>
        <a asp-area="Tenant" asp-controller="Ordenes" asp-action="Index" class="fr-btn fr-btn-ghost">Cancelar</a>
    </div>
</form>

<!-- ── Modal: Usar Plantilla (HU-027) ───────────────────── -->
<div class="modal fade" id="modalUsarPlantilla" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Usar Plantilla</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="fr-form-label">Seleccione una plantilla</label>
                    <select id="selectPlantillaOpcion" class="fr-form-control">
                        <option value="">Cargando plantillas...</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="fr-btn fr-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="fr-btn fr-btn-primary" id="btnConfirmarUsarPlantilla">
                    <i class="ti ti-check"></i> Crear orden
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Alertas en vivo: origen == destino (CA-07) y fechas (CA-06) ──
        function toggleAlertaRuta() {
            const a = document.getElementById('OrigenId').value;
            const b = document.getElementById('DestinoId').value;
            document.getElementById('alertaRutaIgual')
                .classList.toggle('d-none', !(a && b && a === b));
        }

        function toggleAlertaFechas() {
            const p = document.getElementById('FechaPickupSolicitada').value;
            const e = document.getElementById('FechaEntregaRequerida').value;
            document.getElementById('alertaFechas')
                .classList.toggle('d-none', !(p && e && e < p));
        }

        document.getElementById('OrigenId').addEventListener('change', toggleAlertaRuta);
        document.getElementById('DestinoId').addEventListener('change', toggleAlertaRuta);
        document.getElementById('FechaPickupSolicitada').addEventListener('change', toggleAlertaFechas);
        document.getElementById('FechaEntregaRequerida').addEventListener('change', toggleAlertaFechas);

        // ── Bloqueo de envío con mensajes ES vía FrToast ─────────────
        $('#frOrdenForm').on('submit', function (e) {
            const origen = document.getElementById('OrigenId').value;
            const destino = document.getElementById('DestinoId').value;
            const pickup = document.getElementById('FechaPickupSolicitada').value;
            const entrega = document.getElementById('FechaEntregaRequerida').value;

            if (origen && destino && origen === destino) {
                e.preventDefault();
                FrToast.warning('El origen y el destino no pueden ser la misma ubicación');
                return false;
            }
            if (pickup && entrega && entrega < pickup) {
                e.preventDefault();
                FrToast.warning('La fecha de entrega debe ser posterior a la fecha de recogida');
                return false;
            }
        });

        // ── Toast de TempData (server-side create) ─────────────────────
        const frToastMsg = '@(TempData["FrToast"]?.ToString() ?? "")';
        const frToastTipo = '@(TempData["FrToastTipo"]?.ToString() ?? "success")';
        if (frToastMsg) FrToast.show(frToastMsg, frToastTipo);

        // ── Usar Plantilla (HU-027) ──────────────────────────
        document.getElementById('btnUsarPlantilla')?.addEventListener('click', async () => {
            const select = document.getElementById('selectPlantillaOpcion');
            select.innerHTML = '<option value="">Cargando plantillas...</option>';
            FrModal.show('modalUsarPlantilla');

            try {
                const resp = await FrApi.get('/api/plantillas-orden');
                if (resp?.success && resp.data) {
                    if (resp.data.length === 0) {
                        select.innerHTML = '<option value="">No hay plantillas guardadas</option>';
                    } else {
                        select.innerHTML = '<option value="">Seleccione una plantilla</option>' + 
                            resp.data.map(p => `<option value="${p.id}">${String(p.nombre).replace(/</g, '&lt;')}</option>`).join('');
                    }
                } else {
                    select.innerHTML = '<option value="">Error al cargar plantillas</option>';
                }
            } catch (e) {
                select.innerHTML = '<option value="">Error al cargar plantillas</option>';
            }
        });

        document.getElementById('btnConfirmarUsarPlantilla')?.addEventListener('click', async () => {
            const plantillaId = document.getElementById('selectPlantillaOpcion').value;
            if (!plantillaId) {
                FrToast.warning('Seleccione una plantilla');
                return;
            }

            const btn = document.getElementById('btnConfirmarUsarPlantilla');
            btn.disabled = true;
            try {
                const resp = await FrApi.post(`/api/plantillas-orden/${plantillaId}/crear-orden`);
                FrApi.handleResponse(resp, () => {
                    FrToast.success('Orden creada exitosamente a partir de la plantilla');
                    FrModal.hide('modalUsarPlantilla');
                    if (resp.data && resp.data.id) {
                        window.location.href = `/Tenant/Ordenes/Edit/${resp.data.id}`;
                    } else {
                        window.location.href = '/Tenant/Ordenes';
                    }
                });
            } finally {
                btn.disabled = false;
            }
        });
    </script>
}