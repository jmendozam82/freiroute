@using Freiroute.Aplicacion.Areas.Tenant.ViewModels
@using Freiroute.DTO.Orden
@using Freiroute.Utility.Constants
@model OrdenIndexViewModel
@{
    ViewData["Title"] = "Órdenes de Transporte";
    ViewData["ActiveMenu"] = "ordenes";
    string PageUrl(int p) => Url.Action("Index", new { estado = Model.Estado, prioridad = Model.Prioridad, busqueda = Model.Busqueda, po = Model.Po, page = p })!;
}

<nav class="fr-breadcrumb" aria-label="Breadcrumb">
    <span>Operación</span>
    <span class="fr-breadcrumb-sep">/</span>
    <span aria-current="page">Órdenes</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Órdenes de Transporte</h1>
        <div class="fr-page-subtitle">Solicitudes de transporte y seguimiento de su ciclo de vida (HU-021)</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (User.HasPermission("ordenes", "CREATE"))
        {
            <button type="button" class="fr-btn fr-btn-secondary" id="btnImportarCsv"
                    title="Importar órdenes desde CSV/Excel (HU-022)" aria-label="Importar órdenes desde CSV/Excel">
                <i class="ti ti-upload"></i> Importar CSV
            </button>
            <a asp-area="Tenant" asp-controller="Ordenes" asp-action="Create" class="fr-btn fr-btn-primary">
                <i class="ti ti-plus"></i> Nueva orden
            </a>
        }
    </div>
</div>

<div class="fr-kpi-grid">
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Órdenes registradas</div>
        <div class="fr-kpi-value kpi-blue">@Model.Resultados.TotalItems</div>
        <div class="fr-kpi-delta up">@Model.Resultados.PageSize por página</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Borradores (esta página)</div>
        <div class="fr-kpi-value kpi-gray">@Model.Resultados.Items.Count(o => o.Estado == OrdenEstado.Draft)</div>
        <div class="fr-kpi-delta down">Sin número de orden asignado</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">En tránsito (esta página)</div>
        <div class="fr-kpi-value kpi-amber">@Model.Resultados.Items.Count(o => o.Estado == OrdenEstado.InTransit)</div>
        <div class="fr-kpi-delta down">Requieren seguimiento activo</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Críticas (esta página)</div>
        <div class="fr-kpi-value kpi-red">@Model.Resultados.Items.Count(o => o.Prioridad == OrdenPrioridad.Critico)</div>
        <div class="fr-kpi-delta down">Prioridad máxima de atención</div>
    </div>
</div>

<div class="fr-card mb-3">
    <div class="fr-card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="fr-form-label" for="fEstado">Estado</label>
                <select id="fEstado" name="estado" class="fr-form-control">
                    <option value="">Todos los estados</option>
                    @foreach (var kv in OrdenEstado.Labels)
                    {
                        <option value="@kv.Key" selected="@(Model.Estado == kv.Key)">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="fr-form-label" for="fPrioridad">Prioridad</label>
                <select id="fPrioridad" name="prioridad" class="fr-form-control">
                    <option value="">Todas</option>
                    @foreach (var kv in OrdenPrioridad.Labels)
                    {
                        <option value="@kv.Key" selected="@(Model.Prioridad == kv.Key)">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="fr-form-label" for="fBusqueda">Buscar</label>
                <input id="fBusqueda" type="text" name="busqueda" value="@Model.Busqueda" class="fr-form-control"
                       placeholder="Número de orden o referencia del cliente" aria-label="Buscar orden" />
            </div>
            <div class="col-md-3">
                <label class="fr-form-label" for="fPo">N° PO</label>
                <input id="fPo" type="text" name="po" value="@Model.Po" class="fr-form-control fr-id-code"
                       placeholder="ORD-... / AHAA-..." aria-label="Filtrar por número de Purchase Order" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="fr-btn fr-btn-primary w-100">
                    <i class="ti ti-filter"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        @if (User.HasPermission("embarques", "CREATE"))
        {
            <button type="button" class="fr-btn fr-btn-primary d-none" id="btnConsolidarSeleccionadas">
                <i class="ti ti-box-multiple"></i> Consolidar seleccionadas (<span id="countSeleccionadas">0</span>)
            </button>
        }
    </div>
</div>

<div class="fr-table-wrapper">
    <div class="fr-table-responsive">
        <table class="fr-table">
            <thead>
                <tr>
                    <th><input type="checkbox" id="chkAllOrdenes" class="form-check-input" aria-label="Seleccionar todas" /></th>
                    <th>N° Orden</th>
                    <th>Cliente</th>
                    <th>N° PO</th>
                    <th>Ruta</th>
                    <th>Peso</th>
                    <th>Prioridad</th>
                    <th>Entrega</th>
                    <th>SLA</th>
                    <th>Estado</th>
                    <th>Canal</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Resultados.Items.Count() == 0)
                {
                    <tr>
                        <td colspan="12">
                            <div class="fr-empty">
                                <div class="fr-empty-icon"><i class="ti ti-clipboard-list"></i></div>
                                <div class="fr-empty-title">No hay órdenes</div>
                                <div class="fr-empty-text">Cree la primera orden de transporte o ajuste los filtros.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var o in Model.Resultados.Items)
                {
                    <tr>
                        <td>
                            @if (o.Estado == OrdenEstado.Draft || o.Estado == OrdenEstado.Confirmed)
                            {
                                <input type="checkbox" class="form-check-input chk-orden" value="@o.Id" data-estado="@o.Estado" aria-label="Seleccionar orden" />
                            }
                        </td>
                        <td><span class="fr-id-code">@(string.IsNullOrEmpty(o.NumeroOrden) ? "—" : o.NumeroOrden)</span></td>
                        <td>
                            <div class="fw-semibold">@o.ClienteNombre</div>
                            @if (!string.IsNullOrEmpty(o.ReferenciaCliente))
                            {
                                <div class="text-muted">Ref: @o.ReferenciaCliente</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(o.NumeroPo))
                            {
                                <span class="fr-id-code" title="Purchase Order del cliente">@o.NumeroPo</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="text-muted">@o.OrigenNombre</span>
                            <i class="ti ti-arrow-right text-muted mx-1"></i>
                            <span>@o.DestinoNombre</span>
                        </td>
                        <td>@o.PesoKg.ToString("N0") kg</td>
                        <td>
                            @await Html.PartialAsync("_BadgePrioridad", o.Prioridad)
                        </td>
                        <td>@(o.FechaEntregaRequerida?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            @await Html.PartialAsync("_BadgeSla", o.SlaStatus)
                        </td>
                        <td>
                            <span class="fr-badge @o.EstadoBadgeClass">@o.EstadoLabel</span>
                        </td>
                        <td>
                            <span class="fr-badge fr-badge-neutral" title="Canal de ingreso registrado por el sistema — no editable">@o.OrigenCreacion</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-area="Tenant" asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@o.Id" class="fr-btn fr-btn-ghost fr-btn-sm"
                                   title="Ver detalle" aria-label="Ver detalle de la orden @(o.NumeroOrden ?? o.Id.ToString())">
                                    <i class="ti ti-eye"></i>
                                </a>
                                @if (User.HasPermission("ordenes", "UPDATE") && OrdenEstado.Editables.Contains(o.Estado))
                                {
                                    <a asp-area="Tenant" asp-controller="Ordenes" asp-action="Edit" asp-route-id="@o.Id" class="fr-btn fr-btn-ghost fr-btn-sm"
                                       title="Editar" aria-label="Editar la orden @(o.NumeroOrden ?? o.Id.ToString())">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Paginacion", new PaginacionModel
    {
        PaginaActual = Model.Resultados.PageNumber,
        PageSize = Model.Resultados.PageSize,
        TotalItems = Model.Resultados.TotalItems,
        ItemsEnPagina = Model.Resultados.Items.Count(),
        PageUrl = PageUrl,
    })
</div>

<!-- ── Modal: Importar CSV (HU-022) ────────────────────────── -->
<div class="modal fade" id="modalImportarCsv" tabindex="-1" aria-labelledby="modalImportarCsvTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalImportarCsvTitle">Importar órdenes desde CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Descargue la plantilla, complétela y suba el archivo para crear múltiples órdenes masivamente (Fail-soft).</p>
                <div class="mb-4">
                    <a href="/api/ordenes/importar/plantilla" class="fr-btn fr-btn-ghost fr-btn-sm" download>
                        <i class="ti ti-download"></i> Descargar plantilla CSV
                    </a>
                </div>
                <div class="mb-3">
                    <label class="fr-form-label" for="fileCsv">Archivo CSV</label>
                    <input type="file" id="fileCsv" accept=".csv,.xlsx" class="fr-form-control" />
                </div>
                <div id="importErrorContainer" class="d-none fr-form-error mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="fr-btn fr-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="fr-btn fr-btn-primary" id="btnConfirmarImportar">
                    <i class="ti ti-upload"></i> Iniciar importación
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal: Consolidar Órdenes (HU-025) ──────────────────── -->
<div class="modal fade" id="modalConsolidar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Consolidar Órdenes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea crear un Shipment (Embarque) que agrupe las <strong id="lblCantConsolidar">0</strong> órdenes seleccionadas?</p>
                <div class="fr-form-hint">Las órdenes seleccionadas deben tener compatibilidad en zona o ruta para consolidarse.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="fr-btn fr-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="fr-btn fr-btn-primary" id="btnConfirmarConsolidar">
                    <i class="ti ti-check"></i> Consolidar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Toast de TempData (server-side create/edit) ─────────────
    const frToastMsg = '@(TempData["FrToast"]?.ToString() ?? "")';
    const frToastTipo = '@(TempData["FrToastTipo"]?.ToString() ?? "success")';
    if (frToastMsg) FrToast.show(frToastMsg, frToastTipo);

    // ── Importar CSV (HU-022) ───────────────────────────────────
    document.getElementById('btnImportarCsv')?.addEventListener('click', () => {
        document.getElementById('fileCsv').value = '';
        document.getElementById('importErrorContainer').classList.add('d-none');
        document.getElementById('importErrorContainer').innerHTML = '';
        FrModal.show('modalImportarCsv');
    });

    document.getElementById('btnConfirmarImportar')?.addEventListener('click', async () => {
        const fileInput = document.getElementById('fileCsv');
        if (!fileInput.files || fileInput.files.length === 0) {
            FrToast.warning('Seleccione un archivo CSV');
            return;
        }

        const btn = document.getElementById('btnConfirmarImportar');
        btn.disabled = true;
        const errContainer = document.getElementById('importErrorContainer');
        errContainer.classList.add('d-none');
        errContainer.innerHTML = '';

        try {
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            const resp = await fetch('/api/ordenes/importar', {
                method: 'POST',
                headers: { 'Authorization': 'Bearer ' + FrAuth.getToken() },
                body: formData
            });
            const result = await resp.json();

            if (resp.ok) {
                const dto = result.data;
                const creadas = dto ? dto.filasOk : 0;
                const fallidas = dto ? dto.filasError : 0;
                const conErrores = fallidas > 0;

                if (conErrores) {
                    FrToast.warning(`Importación parcial: ${creadas} creadas, ${fallidas} fallidas`);
                    let html = '<ul>';
                    for (let err of dto.detalleErrores) {
                        html += `<li>Fila ${err.fila} [${err.campo}]: ${err.error}</li>`;
                    }
                    html += '</ul>';
                    errContainer.innerHTML = html;
                    errContainer.classList.remove('d-none');
                    btn.disabled = false;
                } else {
                    FrToast.success(`Importación exitosa: ${creadas} órdenes creadas`);
                    FrModal.hide('modalImportarCsv');
                    setTimeout(() => window.location.reload(), 1500);
                }
            } else {
                FrApi.handleResponse(result);
                btn.disabled = false;
            }
        } catch (err) {
            FrToast.error('Error al subir el archivo');
            btn.disabled = false;
        }
    });

    // ── Consolidar Órdenes (HU-025) ─────────────────────────────
    const chkAll = document.getElementById('chkAllOrdenes');
    const chkOrdenes = document.querySelectorAll('.chk-orden');
    const btnConsolidar = document.getElementById('btnConsolidarSeleccionadas');
    const countSpan = document.getElementById('countSeleccionadas');

    function updateConsolidarBtn() {
        const count = document.querySelectorAll('.chk-orden:checked').length;
        if (count > 1) {
            btnConsolidar?.classList.remove('d-none');
            if (countSpan) countSpan.textContent = count;
        } else {
            btnConsolidar?.classList.add('d-none');
        }
    }

    chkAll?.addEventListener('change', (e) => {
        chkOrdenes.forEach(chk => chk.checked = e.target.checked);
        updateConsolidarBtn();
    });

    chkOrdenes.forEach(chk => {
        chk.addEventListener('change', updateConsolidarBtn);
    });

    btnConsolidar?.addEventListener('click', () => {
        const count = document.querySelectorAll('.chk-orden:checked').length;
        document.getElementById('lblCantConsolidar').textContent = count;
        FrModal.show('modalConsolidar');
    });

    document.getElementById('btnConfirmarConsolidar')?.addEventListener('click', async () => {
        const selected = Array.from(document.querySelectorAll('.chk-orden:checked')).map(c => c.value);
        if (selected.length < 2) return;

        const btn = document.getElementById('btnConfirmarConsolidar');
        btn.disabled = true;
        try {
            const resp = await FrApi.post('/api/ordenes/consolidar', {
                ordenesIds: selected
            });
            FrApi.handleResponse(resp, () => {
                FrToast.success('Órdenes consolidadas correctamente');
                FrModal.hide('modalConsolidar');
                setTimeout(() => window.location.reload(), 1000);
            });
        } finally {
            btn.disabled = false;
        }
    });
</script>
}