@model ResetPasswordRequestDto
@{
    ViewData["Title"] = "Nueva contraseña";
    ViewData["HideSidebar"] = true;
    var token = Context.Request.Query["token"].ToString();
}

<div class="fr-auth-wrapper">
    <div class="fr-auth-card">
        <div class="fr-auth-logo">
            <div class="fr-logo-mark">FR</div>
            <span class="fr-logo-text" style="color:var(--fr-navy-primary);font-size:20px">Freiroute TMS</span>
        </div>

        <h1 class="fr-auth-title">Nueva contraseña</h1>
        <p class="fr-auth-subtitle">Crea una nueva contraseña para tu cuenta</p>

        <form id="resetForm" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" value="@token" />

            <div class="mb-3">
                <label asp-for="NewPassword" class="fr-form-label fr-form-required"></label>
                <input asp-for="NewPassword" type="password" class="fr-form-control"
                       placeholder="Nueva contraseña"
                       autocomplete="new-password"
                       data-val="true"
                       data-val-required="La contraseña es obligatoria"
                       data-val-minlength-min="8"
                       data-val-minlength="Debe tener al menos 8 caracteres"
                       data-val-regex-pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$"
                       data-val-regex="Debe contener 1 mayúscula, 1 número y 1 carácter especial" />
                <span asp-validation-for="NewPassword" class="fr-form-error"></span>
                <span class="fr-form-hint">Mínimo 8 caracteres, con mayúscula, número y carácter especial.</span>
            </div>

            <div class="mb-4">
                <label class="fr-form-label fr-form-required">Confirmar contraseña</label>
                <input type="password" id="ConfirmPassword" class="fr-form-control"
                       placeholder="Repite la contraseña"
                       autocomplete="new-password"
                       data-val="true"
                       data-val-required="Confirme la contraseña"
                       data-val-equalto="#NewPassword"
                       data-val-equalto-msg="Las contraseñas no coinciden" />
                <span class="fr-form-error field-validation-valid" data-valmsg-for="ConfirmPassword" data-valmsg-replace="true"></span>
            </div>

            <button type="submit" class="fr-btn fr-btn-primary w-100 justify-content-center" id="btnGuardar" style="padding:11px 16px">
                <i class="ti ti-device-floppy"></i>
                Actualizar contraseña
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-area="Auth" asp-controller="Account" asp-action="Login" style="font-size:12px;color:var(--fr-action-blue);text-decoration:none">
                ← Volver a iniciar sesión
            </a>
        </div>

        <div style="text-align:center;font-size:11px;color:var(--fr-text-muted);margin-top:24px">
            &copy; 2026 Freiroute TMS — Todos los derechos reservados
        </div>
    </div>
</div>

@section Scripts {
<script>
    $.validator.unobtrusive.parse('#resetForm');

    $('#resetForm').on('submit', async function (e) {
        e.preventDefault();
        if (!$(this).valid()) {
            FrToast.warning('Por favor corrija los errores del formulario');
            return;
        }

        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2" style="animation:spin 1s linear infinite"></i> Guardando...';

        const data = {
            token: $('#Token').val(),
            newPassword: $('#NewPassword').val()
        };

        try {
            const resp = await FrApi.post('@Url.Action("ResetPassword", "Account", new { area = "Auth" })', data);
            FrApi.handleResponse(resp, () => {
                FrToast.success(resp.message || 'Contraseña actualizada');
                setTimeout(() => window.location.href = '/Auth/Account/Login', 1200);
            });
        } catch (err) {
            FrToast.error('No se pudo conectar con el servidor');
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="ti ti-device-floppy"></i> Actualizar contraseña';
    });
</script>
}
