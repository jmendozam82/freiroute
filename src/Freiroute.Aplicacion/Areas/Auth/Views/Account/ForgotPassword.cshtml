@model ForgotPasswordRequestDto
@{
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["HideSidebar"] = true;
}

<div class="fr-auth-wrapper">
    <div class="fr-auth-card">
        <div class="fr-auth-logo">
            <div class="fr-logo-mark">FR</div>
            <span class="fr-logo-text" style="color:var(--fr-navy-primary);font-size:20px">Freiroute TMS</span>
        </div>

        <h1 class="fr-auth-title">Recuperar contraseña</h1>
        <p class="fr-auth-subtitle">Te enviaremos un enlace para restablecer tu contraseña</p>

        <form id="forgotForm" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label asp-for="Email" class="fr-form-label fr-form-required"></label>
                <input asp-for="Email" type="email" class="fr-form-control"
                       placeholder="tu@email.com"
                       autocomplete="email"
                       data-val="true"
                       data-val-required="El email es obligatorio"
                       data-val-email="Ingrese un email válido" />
                <span asp-validation-for="Email" class="fr-form-error"></span>
            </div>

            <button type="submit" class="fr-btn fr-btn-primary w-100 justify-content-center" id="btnEnviar" style="padding:11px 16px">
                <i class="ti ti-mail-forward"></i>
                Enviar enlace
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-area="Auth" asp-controller="Account" asp-action="Login" style="font-size:12px;color:var(--fr-action-blue);text-decoration:none">
                ← Volver a iniciar sesión
            </a>
        </div>

        <div style="text-align:center;font-size:11px;color:var(--fr-text-muted);margin-top:24px">
            &copy; 2026 Freiroute TMS — Todos los derechos reservados
        </div>
    </div>
</div>

@section Scripts {
<script>
    $.validator.unobtrusive.parse('#forgotForm');

    $('#forgotForm').on('submit', async function (e) {
        e.preventDefault();
        if (!$(this).valid()) {
            FrToast.warning('Por favor corrija los errores del formulario');
            return;
        }

        const btn = document.getElementById('btnEnviar');
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2" style="animation:spin 1s linear infinite"></i> Enviando...';

        const data = { email: $('#Email').val() };

        try {
            const resp = await FrApi.post('@Url.Action("ForgotPassword", "Account", new { area = "Auth" })', data);
            FrApi.handleResponse(resp, () => {
                FrToast.info('Si el email existe, recibirás un enlace para restablecer tu contraseña.');
            });
        } catch (err) {
            FrToast.error('No se pudo conectar con el servidor');
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="ti ti-mail-forward"></i> Enviar enlace';
    });
</script>
}
