@model Freiroute.DTO.Empresa.EmpresaResponseDto
@{
    ViewData["Title"] = "Detalle de Empresa";
    ViewData["ActiveMenu"] = "empresas";
}

<nav class="fr-breadcrumb" aria-label="breadcrumb">
    <a href="/">Inicio</a>
    <span class="fr-breadcrumb-sep">/</span>
    <a asp-area="Admin" asp-controller="Empresas" asp-action="Index">Empresas</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span>Detalle</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">@Model.Nombre</h1>
        <p class="fr-page-subtitle">@Model.RucNit • @Model.Pais</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Empresas" asp-action="Edit" asp-route-id="@Model.Id" class="fr-btn fr-btn-primary">
            <i class="ti ti-pencil"></i> Editar
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="fr-card mb-4">
            <div class="fr-card-header">
                <span class="fr-card-title">Información General</span>
            </div>
            <div class="fr-card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">ID Sistema</dt>
                    <dd class="col-sm-8"><span class="fr-id-code">@Model.Id</span></dd>

                    <dt class="col-sm-4 text-muted">RUC/NIT</dt>
                    <dd class="col-sm-8">@Model.RucNit</dd>

                    <dt class="col-sm-4 text-muted">Email Admin</dt>
                    <dd class="col-sm-8">@Model.EmailAdmin</dd>

                    <dt class="col-sm-4 text-muted">Teléfono</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>

                    <dt class="col-sm-4 text-muted">País / Ciudad</dt>
                    <dd class="col-sm-8">@Model.Pais / @Model.Ciudad</dd>

                    <dt class="col-sm-4 text-muted">Dirección</dt>
                    <dd class="col-sm-8">@Model.Direccion</dd>

                    <dt class="col-sm-4 text-muted">Fecha Creación</dt>
                    <dd class="col-sm-8">@Model.FechaCreacion.ToString("f")</dd>
                </dl>
            </div>
        </div>
        
        <div class="fr-card">
            <div class="fr-card-header">
                <span class="fr-card-title">Configuración Regional</span>
            </div>
            <div class="fr-card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Moneda Principal</dt>
                    <dd class="col-sm-8">@Model.MonedaPrincipal</dd>

                    <dt class="col-sm-4 text-muted">Zona Horaria</dt>
                    <dd class="col-sm-8">@Model.ZonaHoraria</dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="fr-card mb-4">
            <div class="fr-card-header">
                <span class="fr-card-title">Estado y Suscripción</span>
            </div>
            <div class="fr-card-body">
                <div class="mb-3">
                    <div class="text-muted mb-1" style="font-size:12px;font-weight:600;text-transform:uppercase;">Estado</div>
                    <span class="fr-badge @FrHelper.BadgeClase(Model.Estado)">@FrHelper.EstadoLabel(Model.Estado)</span>
                </div>
                
                <div>
                    <div class="text-muted mb-1" style="font-size:12px;font-weight:600;text-transform:uppercase;">Plan Activo</div>
                    <span class="fr-badge @FrHelper.PlanBadgeClase(Model.PlanSuscripcion)">@Model.PlanSuscripcion</span>
                </div>
            </div>
        </div>
        
        <div class="fr-card">
            <div class="fr-card-header">
                <span class="fr-card-title">Marca (Branding)</span>
            </div>
            <div class="fr-card-body">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:24px;height:24px;border-radius:4px;background-color:@Model.ColorPrimario;margin-right:8px;border:1px solid var(--fr-border)"></div>
                    <span>Primario (@Model.ColorPrimario)</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <div style="width:24px;height:24px;border-radius:4px;background-color:@Model.ColorSecundario;margin-right:8px;border:1px solid var(--fr-border)"></div>
                    <span>Secundario (@Model.ColorSecundario)</span>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <div class="mt-3 text-center p-3" style="border: 1px dashed var(--fr-border); border-radius: 6px;">
                        <img src="@Model.LogoUrl" alt="Logo de @Model.Nombre" style="max-height: 80px; max-width: 100%; object-fit: contain;" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
