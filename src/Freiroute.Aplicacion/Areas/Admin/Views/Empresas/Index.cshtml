@model PagedResult<Freiroute.DTO.Empresa.EmpresaResponseDto>
@{
    ViewData["Title"] = "Empresas";
    ViewData["ActiveMenu"] = "admin-empresas";
}

<!-- Breadcrumb -->
<nav class="fr-breadcrumb" aria-label="breadcrumb">
    <a href="/">Inicio</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span>Empresas</span>
</nav>

<!-- Page header -->
<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Empresas</h1>
        <p class="fr-page-subtitle">@Model.TotalItems tenants</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Empresas" asp-action="Create" class="fr-btn fr-btn-primary">
            <i class="ti ti-plus"></i> Nueva Empresa
        </a>
        <button class="fr-btn fr-btn-ghost" onclick="exportarEmpresasCSV()">
            <i class="ti ti-table-export"></i> Exportar CSV
        </button>
    </div>
</div>

<!-- Filtros -->
<div class="fr-card mb-4">
    <div class="fr-card-body" style="padding:16px">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="fr-form-label">Buscar nombre/email</label>
                <input name="q" value="@ViewData["Q"]" class="fr-form-control"
                       placeholder="Nombre, RUC, email..." />
            </div>
            <div class="col-md-2">
                <label class="fr-form-label">Plan</label>
                <select name="plan" class="fr-form-control">
                    <option value="">Todos</option>
                    <option value="STARTER" selected="@(ViewData["Plan"]?.ToString() == "STARTER")">Starter</option>
                    <option value="PROFESSIONAL" selected="@(ViewData["Plan"]?.ToString() == "PROFESSIONAL")">Professional</option>
                    <option value="ENTERPRISE" selected="@(ViewData["Plan"]?.ToString() == "ENTERPRISE")">Enterprise</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="fr-form-label">Estado</label>
                <select name="estado" class="fr-form-control">
                    <option value="">Todos</option>
                    <option value="ACTIVE" selected="@(ViewData["Estado"]?.ToString() == "ACTIVE")">Activa</option>
                    <option value="SUSPENDED" selected="@(ViewData["Estado"]?.ToString() == "SUSPENDED")">Suspendida</option>
                    <option value="CANCELLED" selected="@(ViewData["Estado"]?.ToString() == "CANCELLED")">Cancelada</option>
                    <option value="PAST_DUE" selected="@(ViewData["Estado"]?.ToString() == "PAST_DUE")">Vencida</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="fr-btn fr-btn-primary">
                    <i class="ti ti-search"></i> Filtrar
                </button>
                <a asp-area="Admin" asp-controller="Empresas" asp-action="Index" class="fr-btn fr-btn-ghost ms-2">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="fr-table-wrapper">
    @if (!Model.Items.Any())
    {
        <div class="fr-empty">
            <div class="fr-empty-icon"><i class="ti ti-inbox"></i></div>
            <div class="fr-empty-title">No hay tenants registrados</div>
            <div class="fr-empty-text">Crea la primera usando el botón "Nueva Empresa"</div>
        </div>
    }
    else
    {
        <table class="fr-table">
            <thead>
                <tr>
                    <th>Empresa</th>
                    <th>RUC/NIT</th>
                    <th>Email Admin</th>
                    <th>País</th>
                    <th>Plan</th>
                    <th>Estado</th>
                    <th>Fecha Registro</th>
                    <th style="width:140px">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                // Clases de fila por estado (DS: sin style="" con colores)
                string rowClase = item.Estado == "PAST_DUE" ? "fr-bg-warning-light"
                               : item.Estado == "SUSPENDED" ? "fr-bg-danger-light" : "";

                <tr class="@rowClase">
                    <td>
                        <span class="fr-id-code">@item.Nombre</span>
                        <small class="text-muted">@item.Pais</small>
                    </td>
                    <td>@item.RucNit</td>
                    <td>@item.EmailAdmin</td>
                    <td>@item.Pais</td>
                    <td>
                        <span class="fr-badge @FrHelper.PlanBadgeClase(item.PlanSuscripcion)">@item.PlanSuscripcion</span>
                    </td>
                    <td>
                        <span class="fr-badge @FrHelper.BadgeClase(item.Estado)">@FrHelper.EstadoLabel(item.Estado)</span>
                    </td>
                    <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-area="Admin" asp-controller="Empresas" asp-action="Detail" asp-route-id="@item.Id"
                               class="fr-btn fr-btn-ghost fr-btn-sm" title="Ver detalle" aria-label="Ver detalle">
                                <i class="ti ti-eye"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Empresas" asp-action="Edit" asp-route-id="@item.Id"
                               class="fr-btn fr-btn-ghost fr-btn-sm" title="Editar" aria-label="Editar">
                                <i class="ti ti-pencil"></i>
                            </a>
                            <button class="fr-btn fr-btn-ghost fr-btn-sm"
                                    data-fr-deactivate="/api/empresas/@item.Id/deactivate"
                                    data-fr-nombre="@item.Nombre"
                                    title="Desactivar" aria-label="Desactivar">
                                <i class="ti ti-trash" style="color:var(--fr-danger)"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <!-- Paginación -->
        <div class="fr-pagination">
            <span class="fr-pagination-info">
                Mostrando @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems))
                de @Model.TotalItems registros
            </span>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Empresas" asp-action="Index"
                   asp-route-page="@(Model.HasPreviousPage ? Model.PageNumber - 1 : 1)" asp-route-q="@ViewData["Q"]" asp-route-plan="@ViewData["Plan"]" asp-route-estado="@ViewData["Estado"]"
                   class="fr-page-btn @(Model.HasPreviousPage ? "" : "disabled")">
                    ← Anterior
                </a>
                <a asp-area="Admin" asp-controller="Empresas" asp-action="Index"
                   asp-route-page="@(Model.HasNextPage ? Model.PageNumber + 1 : 1)" asp-route-q="@ViewData["Q"]" asp-route-plan="@ViewData["Plan"]" asp-route-estado="@ViewData["Estado"]"
                   class="fr-page-btn @(Model.HasNextPage ? "" : "disabled")">
                    Siguiente →
                </a>
            </div>
        </div>
    }
</div>

<script>
function exportarEmpresasCSV() {
    window.location.href = '/api/admin/empresas/export';
}
</script>