@model EmpresaRequestDto
@{
    ViewData["Title"]      = "Nueva Empresa";
    ViewData["ActiveMenu"] = "empresas";
}

<nav class="fr-breadcrumb" aria-label="breadcrumb">
    <a href="/">Inicio</a>
    <span class="fr-breadcrumb-sep">/</span>
    <a asp-area="Admin" asp-controller="Empresas" asp-action="Index">Empresas</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span>Nueva</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Nueva Empresa</h1>
        <p class="fr-page-subtitle">Registra un nuevo tenant en la plataforma Freiroute</p>
    </div>
</div>

<div class="fr-card" style="max-width:760px">
    <div class="fr-card-header">
        <span class="fr-card-title">Datos de la Empresa</span>
    </div>
    <div class="fr-card-body">
        <form id="frForm" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Sección: Datos de la Empresa -->
            <div class="form-section-title">Datos de la Empresa</div>
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="Nombre" class="fr-form-label fr-form-required"></label>
                    <input asp-for="Nombre" class="fr-form-control"
                           placeholder="Nombre de la empresa"
                           data-val="true"
                           data-val-required="El nombre es obligatorio"
                           data-val-maxlength-max="200"
                           data-val-maxlength="No puede exceder 200 caracteres" />
                    <span asp-validation-for="Nombre" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="RucNit" class="fr-form-label"></label>
                    <input asp-for="RucNit" class="fr-form-control" placeholder="RUC NIT" />
                    <span asp-validation-for="RucNit" class="fr-form-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EmailAdmin" class="fr-form-label fr-form-required"></label>
                    <input asp-for="EmailAdmin" type="email" class="fr-form-control"
                           placeholder="admin@empresa.com"
                           data-val="true"
                           data-val-required="El email del administrador es obligatorio"
                           data-val-email="Ingrese un email válido" />
                    <span asp-validation-for="EmailAdmin" class="fr-form-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefono" class="fr-form-label"></label>
                    <input asp-for="Telefono" class="fr-form-control" placeholder="+505 0000 0000" />
                    <span asp-validation-for="Telefono" class="fr-form-error"></span>
                </div>
            </div>

            <!-- Sección: Ubicación -->
            <div class="form-section-title">Ubicación</div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Pais" class="fr-form-label fr-form-required"></label>
                    <select asp-for="Pais" class="fr-form-control"
                            data-val="true" data-val-required="El país es obligatorio">
                        <option value="">-- Seleccionar --</option>
                        <option value="Nicaragua">Nicaragua</option>
                        <option value="Costa Rica">Costa Rica</option>
                        <option value="Honduras">Honduras</option>
                        <option value="El Salvador">El Salvador</option>
                        <option value="Guatemala">Guatemala</option>
                        <option value="México">México</option>
                        <option value="Panamá">Panamá</option>
                        <option value="Estados Unidos">Estados Unidos</option>
                    </select>
                    <span asp-validation-for="Pais" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Ciudad" class="fr-form-label"></label>
                    <input asp-for="Ciudad" class="fr-form-control" placeholder="Ciudad" />
                    <span asp-validation-for="Ciudad" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Direccion" class="fr-form-label"></label>
                    <input asp-for="Direccion" class="fr-form-control" placeholder="Dirección" />
                    <span asp-validation-for="Direccion" class="fr-form-error"></span>
                </div>
            </div>

            <!-- Sección: Configuración -->
            <div class="form-section-title">Configuración</div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="PlanSuscripcion" class="fr-form-label fr-form-required"></label>
                    <select asp-for="PlanSuscripcion" class="fr-form-control"
                            data-val="true" data-val-required="Seleccione un plan">
                        <option value="STARTER">STARTER</option>
                        <option value="PROFESSIONAL">PROFESSIONAL</option>
                        <option value="ENTERPRISE">ENTERPRISE</option>
                    </select>
                    <span asp-validation-for="PlanSuscripcion" class="fr-form-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MonedaPrincipal" class="fr-form-label"></label>
                    <select asp-for="MonedaPrincipal" class="fr-form-control">
                        <option value="USD">USD — Dólar</option>
                        <option value="NIO">NIO — Córdoba</option>
                        <option value="EUR">EUR — Euro</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ZonaHoraria" class="fr-form-label"></label>
                    <select asp-for="ZonaHoraria" class="fr-form-control">
                        <option value="America/Managua">America/Managua</option>
                        <option value="America/Costa_Rica">America/Costa_Rica</option>
                        <option value="America/Guatemala">America/Guatemala</option>
                        <option value="America/El_Salvador">America/El_Salvador</option>
                        <option value="America/Mexico_City">America/Mexico_City</option>
                        <option value="America/Panama">America/Panama</option>
                        <option value="America/New_York">America/New_York</option>
                    </select>
                </div>
            </div>

            <!-- Sección: Personalización -->
            <div class="form-section-title">Personalización</div>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label asp-for="ColorPrimario" class="fr-form-label"></label>
                    <input asp-for="ColorPrimario" type="color" class="form-control form-control-color"
                           value="#1A73E8" style="height:38px" />
                    <span asp-validation-for="ColorPrimario" class="fr-form-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ColorSecundario" class="fr-form-label"></label>
                    <input asp-for="ColorSecundario" type="color" class="form-control form-control-color"
                           value="#0B2545" style="height:38px" />
                    <span asp-validation-for="ColorSecundario" class="fr-form-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LogoUrl" class="fr-form-label"></label>
                    <input asp-for="LogoUrl" class="fr-form-control" placeholder="https://..." />
                    <span asp-validation-for="LogoUrl" class="fr-form-error"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid var(--fr-border)">
                <button type="submit" class="fr-btn fr-btn-primary" id="btnGuardar">
                    <i class="ti ti-device-floppy"></i>
                    Crear Empresa
                </button>
                <a asp-area="Admin" asp-controller="Empresas" asp-action="Index" class="fr-btn fr-btn-ghost">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    $.validator.unobtrusive.parse('#frForm');

    $('#frForm').on('submit', async function (e) {
        e.preventDefault();
        if (!$(this).valid()) {
            FrToast.warning('Por favor corrija los errores del formulario');
            return;
        }

        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2 fr-spin"></i> Guardando...';

        const data = Object.fromEntries(new FormData(this));

        const resp = await FrApi.post('/api/empresas', data);

        FrApi.handleResponse(resp, () => {
            setTimeout(() => window.location.href = '@Url.Action("Index", "Empresas", new { area = "Admin" })', 800);
        });

        btn.disabled = false;
        btn.innerHTML = '<i class="ti ti-device-floppy"></i> Crear Empresa';
    });
</script>
}
