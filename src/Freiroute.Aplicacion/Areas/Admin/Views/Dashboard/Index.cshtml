@model Freiroute.DTO.Admin.DashboardGlobalResponseDto
@{
    ViewData["Title"] = "Panel de Administración";
    ViewData["ActiveMenu"] = "admin-dashboard";
}

<!-- Page header -->
<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Panel de Administración Global</h1>
        <p class="fr-page-subtitle">Freiroute SaaS · @DateTime.Now.ToString("yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <button class="fr-btn fr-btn-ghost" onclick="cargarDashboard()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>
</div>

<!-- KPI Grid -->
<div class="fr-kpi-grid">
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Tenants activos</div>
        <div class="fr-kpi-value kpi-blue">@Model.TotalEmpresasActivas</div>
        <div class="fr-kpi-delta">Tenant raíz incluido</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">Nuevos este mes</div>
        <div class="fr-kpi-value kpi-green">@Model.NuevasEstesMes</div>
        <div class="fr-kpi-delta">Nuevos registros</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">MRR</div>
        <div class="fr-kpi-value kpi-blue">$@Model.Mrr.ToString("N0")</div>
        <div class="fr-kpi-delta">Ingresos mensuales recurrentes</div>
    </div>
    <div class="fr-kpi-card">
        <div class="fr-kpi-label">ARR</div>
        <div class="fr-kpi-value kpi-green">$@Model.Arr.ToString("N0")</div>
        <div class="fr-kpi-delta">Ingresos anuales recurrentes</div>
    </div>
</div>

<!-- Fila de 2 cards -->
<div class="row g-4 mt-4">
    <!-- Card izquierda: Empresas por estado -->
    <div class="col-lg-6">
        <div class="fr-card h-100">
            <div class="fr-card-header">
                <span class="fr-card-title">Empresas por estado</span>
            </div>
            <div class="fr-card-body p-0">
                <table class="fr-table">
                    <tbody>
                        <tr>
                            <td><span class="fr-badge fr-badge-success">ACTIVE</span></td>
                            <td class="text-end fr-kpi-count" data-kpi="ACTIVE">@Model.EmpresasPorEstado["ACTIVE"]</td>
                        </tr>
                        <tr>
                            <td><span class="fr-badge fr-badge-neutral">TRIAL</span></td>
                            <td class="text-end fr-kpi-count" data-kpi="TRIAL">@Model.EmpresasPorEstado["TRIAL"]</td>
                        </tr>
                        <tr>
                            <td><span class="fr-badge fr-badge-warning">PAST_DUE</span></td>
                            <td class="text-end fr-kpi-count" data-kpi="PAST_DUE">@Model.EmpresasPorEstado["PAST_DUE"]</td>
                        </tr>
                        <tr>
                            <td><span class="fr-badge fr-badge-warning">SUSPENDED</span></td>
                            <td class="text-end fr-kpi-count" data-kpi="SUSPENDED">@Model.EmpresasPorEstado["SUSPENDED"]</td>
                        </tr>
                        <tr>
                            <td><span class="fr-badge fr-badge-danger">CANCELLED</span></td>
                            <td class="text-end fr-kpi-count" data-kpi="CANCELLED">@Model.EmpresasPorEstado["CANCELLED"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Card derecha: Empresas por plan -->
    <div class="col-lg-6">
        <div class="fr-card h-100">
            <div class="fr-card-header">
                <span class="fr-card-title">Empresas por plan</span>
            </div>
            <div class="fr-card-body p-0">
                <table class="fr-table">
                    <tbody>
                        <tr>
                            <td><span class="fr-badge fr-badge-neutral">STARTER</span></td>
                            <td class="text-end fr-kpi-count" data-kpi-plan="STARTER">@Model.EmpresasPorPlan["STARTER"]</td>
                        </tr>
                        <tr>
                            <td><span class="fr-badge fr-badge-info">PROFESSIONAL</span></td>
                            <td class="text-end fr-kpi-count" data-kpi-plan="PROFESSIONAL">@Model.EmpresasPorPlan["PROFESSIONAL"]</td>
                        </tr>
                        <tr>
                            <td><span class="fr-badge fr-badge-success">ENTERPRISE</span></td>
                            <td class="text-end fr-kpi-count" data-kpi-plan="ENTERPRISE">@Model.EmpresasPorPlan["ENTERPRISE"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Card por vencer en 15 días -->
<div class="fr-card mt-4">
    <div class="fr-card-header">
        <span class="fr-card-title">Por vencer en 15 días</span>
    </div>
    <div class="fr-card-body p-0">
        <div class="fr-table-responsive">
            <table class="fr-table">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Plan</th>
                        <th>Vencimiento</th>
                        <th style="width:120px">Días restantes</th>
                        <th style="width:140px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.TenantsPorVencer)
                {
                    var dias = item.DiasParaVencimiento > 0 ? item.DiasParaVencimiento : 0;
                    var filaClase = dias <= 1 ? "fr-bg-danger-light"
                                  : dias <= 7 ? "fr-bg-warning-light" : "";
                    <tr class="@filaClase">
                        <td>
                            <span class="fr-id-code">@item.EmpresaNombre</span>
                        </td>
                        <td>
                            <span class="fr-badge @(item.PlanCodigo == "STARTER" ? "fr-badge-neutral" : item.PlanCodigo == "PROFESSIONAL" ? "fr-badge-info" : "fr-badge-success")">@item.PlanCodigo</span>
                        </td>
                        <td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                        <td>@dias</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Empresas" asp-action="Detail" asp-route-id="@item.EmpresaId"
                               class="fr-btn fr-btn-ghost fr-btn-sm" title="Ver detalle" aria-label="Ver detalle">
                                <i class="ti ti-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Scripts para dashboard -->
@section Scripts {
<script>
async function cargarDashboard() {
    const resp = await FrApi.get('/api/admin/dashboard');
    FrApi.handleResponse(resp, data => {
        if (data) renderDashboard(data);
    });
}

function renderDashboard(data) {
    // Actualizar KPIs (propiedades camelCase del JSON de la API)
    const kpiBlue  = document.querySelectorAll('.fr-kpi-value.kpi-blue');
    const kpiGreen = document.querySelectorAll('.fr-kpi-value.kpi-green');
    if (kpiBlue[0])  kpiBlue[0].textContent  = data.totalEmpresasActivas ?? '0';
    if (kpiGreen[0]) kpiGreen[0].textContent = data.nuevasEstesMes ?? '0';
    if (kpiBlue[1])  kpiBlue[1].textContent  = '$' + (data.mrr ?? 0).toLocaleString();
    if (kpiGreen[1]) kpiGreen[1].textContent = '$' + (data.arr ?? 0).toLocaleString();

    // Actualizar empresas por estado
    const estado = data.empresasPorEstado || {};
    document.querySelectorAll('[data-kpi]').forEach(td => {
        const key = td.dataset.kpi;
        if (estado[key] !== undefined) td.textContent = estado[key];
    });

    // Actualizar empresas por plan
    const plan = data.empresasPorPlan || {};
    document.querySelectorAll('[data-kpi-plan]').forEach(td => {
        const key = td.dataset.kpiPlan;
        if (plan[key] !== undefined) td.textContent = plan[key];
    });
}
</script>
}