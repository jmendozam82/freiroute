@using Freiroute.DTO.Perfil
@{
    ViewData["Title"] = "Usuarios";
    ViewData["ActiveMenu"] = "usuarios";
    var perfiles = ViewData["Perfiles"] as IEnumerable<PerfilResponseDto> ?? Array.Empty<PerfilResponseDto>();
}

<nav class="fr-breadcrumb" aria-label="breadcrumb">
    <a asp-area="Admin" asp-controller="Home" asp-action="Index">Inicio</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span>Usuarios</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Gestión de Usuarios</h1>
        <p class="fr-page-subtitle">Usuarios del tenant y sus perfiles asignados</p>
    </div>
    <div class="fr-page-actions">
        <button class="btn btn-primary" onclick="window.usuarios.abrirModalInvitar()">
            <i class="ti ti-mail-forward me-1"></i> Invitar Usuario
        </button>
    </div>
</div>

<!-- Filtros -->
<div class="fr-card mb-4">
    <div class="fr-card-body" style="padding:16px">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="fr-form-label">Buscar</label>
                <input type="text" id="searchQuery" class="fr-form-control" placeholder="Nombre o email..." onkeyup="window.usuarios.filtrarUsuarios()" />
            </div>
            <div class="col-md-3">
                <label class="fr-form-label">Estado</label>
                <select id="filterEstado" class="fr-form-control" onchange="window.usuarios.filtrarUsuarios()">
                    <option value="">Todos</option>
                    <option value="ACTIVE">Activos</option>
                    <option value="INACTIVE">Inactivos</option>
                    <option value="PENDING">Pendientes</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="fr-form-label">Perfil</label>
                <select id="filterPerfil" class="fr-form-control" onchange="window.usuarios.filtrarUsuarios()">
                    <option value="">Todos</option>
                    @foreach (var perfil in perfiles)
                    {
                        <option value="@perfil.Id">@perfil.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="button" class="fr-btn fr-btn-ghost ms-2" onclick="window.usuarios.limpiarFiltros()">Limpiar</button>
            </div>
        </div>
    </div>
</div>

<div class="fr-card">
    <div class="fr-card-body p-0">
        <div class="table-responsive">
            <table class="table fr-table" id="usuariosTable">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Perfil</th>
                        <th>Estado</th>
                        <th>Último Acceso</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="6" class="text-center py-4">Cargando usuarios...</td></tr>
                </tbody>
            </table>
        </div>
        <!-- Paginación -->
        <div class="fr-pagination d-flex justify-content-between align-items-center p-3 border-top" id="usuariosPagination" style="display: none;">
            <span class="fr-pagination-info text-muted small" id="paginationInfo"></span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevPage" onclick="window.usuarios.prevPage()">← Anterior</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextPage" onclick="window.usuarios.nextPage()">Siguiente →</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Invitar -->
<div class="modal fade" id="modalInvitar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Invitar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formInvitar" onsubmit="window.usuarios.invitarUsuario(event)">
                    <div class="mb-3">
                        <label class="form-label">Nombre Completo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="nombreCompleto" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" name="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Perfil <span class="text-danger">*</span></label>
                        <select class="form-select" name="perfilId" required>
                            <option value="">Selecciona un perfil</option>
                            @foreach (var perfil in perfiles)
                            {
                                <option value="@perfil.Id">@perfil.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary ms-2" id="btnSubmitInvitar">Enviar Invitación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEditar" onsubmit="window.usuarios.editarUsuario(event)">
                    <input type="hidden" name="id" id="edit_id" />
                    <div class="mb-3">
                        <label class="form-label">Email (Solo lectura)</label>
                        <input type="email" class="form-control" id="edit_email" readonly disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre Completo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="nombreCompleto" id="edit_nombreCompleto" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input type="text" class="form-control" name="telefono" id="edit_telefono" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Perfil <span class="text-danger">*</span></label>
                        <select class="form-select" name="perfilId" id="edit_perfilId" required>
                            <option value="">Selecciona un perfil</option>
                            @foreach (var perfil in perfiles)
                            {
                                <option value="@perfil.Id">@perfil.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary ms-2" id="btnSubmitEditar">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/usuarios.js"></script>
}
