@model PerfilResponseDto
@using Freiroute.Utility.Constants
@{
    ViewData["Title"]      = "Permisos — " + Model.Nombre;
    ViewData["ActiveMenu"] = "perfiles";

    var permisos = (ViewData["Permisos"] as IEnumerable<PermisoResponseDto>) ?? Enumerable.Empty<PermisoResponseDto>();

    var modulos = new[] {
        (ModuloPermiso.Ordenes,       "Órdenes"),
        (ModuloPermiso.Embarques,     "Embarques"),
        (ModuloPermiso.Carriers,      "Carriers"),
        (ModuloPermiso.Rutas,         "Rutas"),
        (ModuloPermiso.TrackTrace,    "Track & Trace"),
        (ModuloPermiso.Documentos,    "Documentos"),
        (ModuloPermiso.Flota,         "Flota"),
        (ModuloPermiso.Analytics,     "Analytics"),
        (ModuloPermiso.Facturacion,   "Facturación"),
        (ModuloPermiso.Clientes,      "Clientes"),
        (ModuloPermiso.Usuarios,      "Usuarios"),
        (ModuloPermiso.Configuracion, "Configuración")
    };

    // Los permisos del SUPER_ADMIN y de perfiles de sistema se administran por el sistema.
    var esSistema = Model.EsSistema || Model.TipoPerfil == "SUPER_ADMIN" || Model.TipoPerfil == "ADMIN";
}

<nav class="fr-breadcrumb" aria-label="breadcrumb">
    <a href="/">Inicio</a>
    <span class="fr-breadcrumb-sep">/</span>
    <a asp-area="Admin" asp-controller="Perfiles" asp-action="Index">Perfiles</a>
    <span class="fr-breadcrumb-sep">/</span>
    <span>Permisos — @Model.Nombre</span>
</nav>

<div class="fr-page-header">
    <div>
        <h1 class="fr-page-title">Permisos — @Model.Nombre</h1>
        <p class="fr-page-subtitle">Configura los permisos granulares por módulo de este perfil</p>
    </div>
</div>

@if (esSistema)
{
    <div class="alert-fr-info mb-4">
        <i class="ti ti-info-circle me-1"></i>
        @if (Model.TipoPerfil == "SUPER_ADMIN")
        {
            <text>El perfil SUPER_ADMIN tiene acceso total implícito y no requiere configuración de permisos.</text>
        }
        else
        {
            <text>Los permisos de este perfil son administrados por el sistema.</text>
        }
    </div>
}

<div class="fr-table-wrapper @(esSistema ? "opacity-75" : "")" style="max-width:820px">
    <table class="fr-table">
        <thead>
            <tr>
                <th>Módulo</th>
                <th style="width:90px;text-align:center">Leer</th>
                <th style="width:90px;text-align:center">Crear</th>
                <th style="width:100px;text-align:center">Actualizar</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var (modulo, label) in modulos)
        {
            var permiso = permisos.FirstOrDefault(p => p.Modulo == modulo);
            var tienePermiso = permiso?.PuedeLeer == true || permiso?.PuedeCrear == true || permiso?.PuedeActualizar == true;
            <tr class="permiso-fila @(tienePermiso ? "fr-fila-activa" : "")" data-modulo="@modulo">
                <td style="font-weight:600">@label</td>
                <td style="text-align:center">
                    <input type="checkbox" class="form-check-input permiso-check"
                           data-modulo="@modulo" data-accion="leer"
                           @(permiso?.PuedeLeer == true ? "checked" : "")
                           @(esSistema ? "disabled" : "")
                           style="cursor:pointer" />
                </td>
                <td style="text-align:center">
                    <input type="checkbox" class="form-check-input permiso-check"
                           data-modulo="@modulo" data-accion="crear"
                           @(permiso?.PuedeCrear == true ? "checked" : "")
                           @(esSistema ? "disabled" : "")
                           style="cursor:pointer" />
                </td>
                <td style="text-align:center">
                    <input type="checkbox" class="form-check-input permiso-check"
                           data-modulo="@modulo" data-accion="actualizar"
                           @(permiso?.PuedeActualizar == true ? "checked" : "")
                           @(esSistema ? "disabled" : "")
                           style="cursor:pointer" />
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!esSistema)
{
    <div class="d-flex gap-2 mt-4">
        <button type="button" class="fr-btn fr-btn-primary" id="btnGuardarPermisos">
            <i class="ti ti-device-floppy"></i>
            Guardar Permisos
        </button>
        <a asp-area="Admin" asp-controller="Perfiles" asp-action="Index" class="fr-btn fr-btn-ghost">Cancelar</a>
    </div>
}
else
{
    <div class="d-flex gap-2 mt-4">
        <a asp-area="Admin" asp-controller="Perfiles" asp-action="Index" class="fr-btn fr-btn-ghost">Volver a Perfiles</a>
    </div>
}

@section Scripts {
<script>
    // ── Estado inicial: resaltar filas con permisos ─────────────
    function actualizarResaltadoFila(tr) {
        const leer = tr.querySelector('[data-accion="leer"]').checked;
        const crear = tr.querySelector('[data-accion="crear"]').checked;
        const actualizar = tr.querySelector('[data-accion="actualizar"]').checked;
        tr.classList.toggle('fr-fila-activa', leer || crear || actualizar);
    }

    // ── Reglas de interdependencia de checkboxes ───────────────
    document.querySelectorAll('.permiso-check').forEach(chk => {
        chk.addEventListener('change', function () {
            const tr = this.closest('.permiso-fila');
            const leer = tr.querySelector('[data-accion="leer"]');
            const crear = tr.querySelector('[data-accion="crear"]');
            const actualizar = tr.querySelector('[data-accion="actualizar"]');
            const accion = this.dataset.accion;

            if (accion === 'leer') {
                // Si Leer se desmarca → desmarcar también Crear y Actualizar
                if (!this.checked) {
                    crear.checked = false;
                    actualizar.checked = false;
                }
            } else {
                // Si Crear o Actualizar se marca → marcar Leer automáticamente
                if (this.checked) {
                    leer.checked = true;
                }
            }

            actualizarResaltadoFila(tr);
        });
    });

    // ── Guardar permisos ───────────────────────────────────────
    $('#btnGuardarPermisos')?.on('click', async function () {
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2 fr-spin"></i> Guardando...';

        // Agrupar por módulo
        const modulos = {};
        document.querySelectorAll('.permiso-check:not(:disabled)').forEach(chk => {
            const modulo = chk.dataset.modulo;
            const accion = chk.dataset.accion;
            if (!modulos[modulo]) modulos[modulo] = { leer: false, crear: false, actualizar: false };
            modulos[modulo][accion] = chk.checked;
        });

        const payload = {
            perfilId: '@Model.Id',
            modulos: Object.keys(modulos).map(m => ({
                modulo: m,
                puedeLeer: modulos[m].leer,
                puedeCrear: modulos[m].crear,
                puedeActualizar: modulos[m].actualizar
            }))
        };

        const resp = await FrApi.put('/api/perfiles/@Model.Id/permisos', payload);

        FrApi.handleResponse(resp, () => {
            setTimeout(() => window.location.href = '@Url.Action("Index", "Perfiles", new { area = "Admin" })', 800);
        });

        btn.disabled = false;
        btn.innerHTML = '<i class="ti ti-device-floppy"></i> Guardar Permisos';
    });
</script>
}
