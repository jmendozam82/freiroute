<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Freiroute — Configuración inicial</title>
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler-icons-webfont@3.0.0/dist/tabler-icons.min.css" />
    <!-- Google Fonts (preconnect) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Freiroute Design System -->
    <link rel="stylesheet" href="~/css/freiroute.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="fr-ow-body">

  @* Token antiforgery para las peticiones AJAX de FrApi (header RequestVerificationToken). *@
  @Html.AntiForgeryToken()

  <!-- Header mínimo -->
  <header class="fr-ow-header">
    <div class="fr-ow-header-row">
      <div class="fr-logo-mark">FR</div>
      <span class="fr-ow-header-name">Freiroute</span>
      <span class="fr-ow-header-tag">
        Configuración inicial
      </span>
    </div>
  </header>

  <!-- Barra de progreso -->
  <div class="fr-ow-progress">
    <div class="fr-ow-progress-inner">
      <div class="fr-ow-progress-top">
        <span class="fr-ow-progress-label">
          Paso @ViewData["Paso"] de 5
        </span>
        <span class="fr-ow-progress-pct">
          @ViewData["Porcentaje"]% completado
        </span>
      </div>
      <!-- Barra de progreso (width dinámico proviene del ViewData, no es color) -->
      <div class="fr-ow-bar">
        <div class="fr-ow-bar-fill" style="width:@ViewData["Porcentaje"]%"></div>
      </div>
      <!-- Steps indicadores -->
      <div class="fr-ow-steps">
        @for (int i = 1; i <= 5; i++) {
          var esPasoActual = ((int?)ViewData["Paso"] ?? 0) == i;
          var esPasado = ((int?)ViewData["Paso"] ?? 0) > i;
          <div class="fr-ow-step">
            <div class="fr-ow-step-dot @(esPasoActual ? "is-current" : esPasado ? "is-past" : "")">
              @(esPasado ? "✓" : i.ToString())
            </div>
            <span class="fr-ow-step-label">
              @(i switch { 1 => "Empresa", 2 => "Visual",
                           3 => "Operación", 4 => "Admin", 5 => "Equipo", _ => "" })
            </span>
          </div>
        }
      </div>
    </div>
  </div>

  <!-- Contenido del paso -->
  <main class="fr-ow-main">
    @RenderBody()
  </main>

  <!-- Contenedor de toasts (FrToast) -->
  <div class="fr-toast-container" id="frToastContainer"></div>

  <!-- Bootstrap JS -->
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery + Validate -->
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
  <!-- Freiroute JS -->
  <script src="~/js/freiroute.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>