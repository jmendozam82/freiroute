@{
    ViewData["Paso"] = 1;
    ViewData["Porcentaje"] = 20;
    Layout = "~/Areas/Onboarding/Views/_LayoutOnboarding.cshtml";
}

<div class="fr-card">
    <div class="fr-card-header">
        <span class="fr-card-title">Datos de tu empresa</span>
        <p style="margin-top:4px; font-size:13px; color:var(--fr-text-secondary)">
            Ingresa la información básica de tu empresa de transporte
        </p>
    </div>
    <div class="fr-card-body">
        <div class="row g-3">
            <div class="col-12">
                <label class="fr-form-label">Nombre de la empresa *</label>
                <input type="text" id="nombre" class="fr-form-control"
                       placeholder="Ej: Transportes del Norte S.A."
                       data-val="true"
                       data-val-required="El nombre es obligatorio"
                       data-val-maxlength-max="200"
                       data-val-maxlength="No puede exceder 200 caracteres" />
                <span class="fr-form-error" data-valmsg-for="nombre"></span>
            </div>
            <div class="col-md-6">
                <label class="fr-form-label">RUC / NIT</label>
                <input type="text" id="rucNit" class="fr-form-control"
                       placeholder="Ej: J0310000123456" />
            </div>
            <div class="col-md-6">
                <label class="fr-form-label">Teléfono</label>
                <input type="text" id="telefono" class="fr-form-control"
                       placeholder="Ej: +505 2222-3333" />
            </div>
            <div class="col-12">
                <label class="fr-form-label">Industria</label>
                <select id="industria" class="fr-form-control">
                    <option value="">-- Seleccionar --</option>
                    <option value="Transporte de carga">Transporte de carga</option>
                    <option value="Transporte de personas">Transporte de personas</option>
                    <option value="Logística">Logística</option>
                    <option value="Courier">Courier y mensajería</option>
                    <option value="Distribución">Distribución</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
            <div class="col-12">
                <label class="fr-form-label">Dirección</label>
                <textarea id="direccion" class="fr-form-control" rows="2"
                          placeholder="Dirección fiscal de la empresa"></textarea>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid var(--fr-border)">
            <button type="button" class="fr-btn fr-btn-primary" id="btnContinuar">
                Continuar <i class="ti ti-arrow-right"></i>
            </button>
            <button type="button" class="fr-btn fr-btn-ghost" id="btnSaltar">
                Saltar por ahora
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('btnContinuar').addEventListener('click', async () => {
        const btn = document.getElementById('btnContinuar');
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2" style="animation:spin 1s linear infinite"></i> Guardando...';

        const resp = await FrApi.put('/api/onboarding/paso/1', {
            nombre:    document.getElementById('nombre').value.trim(),
            rucNit:    document.getElementById('rucNit').value.trim(),
            telefono:  document.getElementById('telefono').value.trim(),
            industria: document.getElementById('industria').value,
            direccion: document.getElementById('direccion').value.trim()
        });

        if (resp?.success) {
            window.location.href = '/onboarding/paso/2';
        } else {
            FrToast.error(resp?.message || 'Error al guardar');
            btn.disabled = false;
            btn.innerHTML = 'Continuar <i class="ti ti-arrow-right"></i>';
        }
    });

    document.getElementById('btnSaltar')
        .addEventListener('click', () => {
            window.location.href = '/onboarding/paso/2';
        });
</script>
}
