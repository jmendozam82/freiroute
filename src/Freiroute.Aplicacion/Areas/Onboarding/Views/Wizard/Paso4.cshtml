@{
    ViewData["Paso"] = 4;
    ViewData["Porcentaje"] = 80;
    Layout = "~/Areas/Onboarding/Views/_LayoutOnboarding.cshtml";
    var nombreUsuario = ViewData["NombreUsuario"]?.ToString() ?? "";
}

<div class="fr-card">
    <div class="fr-card-header">
        <span class="fr-card-title">Tu cuenta de administrador</span>
        <p style="margin-top:4px; font-size:13px; color:var(--fr-text-secondary)">
            Confirma o actualiza tu información de administrador
        </p>
    </div>
    <div class="fr-card-body">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="fr-form-label">Nombre completo *</label>
                <input type="text" id="nombreCompleto" class="fr-form-control"
                       value="@nombreUsuario"
                       data-val="true"
                       data-val-required="El nombre es obligatorio" />
                <span class="fr-form-error" data-valmsg-for="nombreCompleto"></span>
            </div>
            <div class="col-md-4">
                <label class="fr-form-label">Teléfono</label>
                <input type="tel" id="telefono" class="fr-form-control"
                       placeholder="+505 0000 0000" />
            </div>
        </div>

        <!-- Cambio de contraseña -->
        <div class="mt-4">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="chkCambiarPassword" />
                <label class="form-check-label" for="chkCambiarPassword">
                    Cambiar contraseña
                </label>
            </div>
        </div>

        <div id="seccionPassword" style="margin-top:16px; display:none">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="fr-form-label">Nueva contraseña *</label>
                    <input type="password" id="nuevoPassword" class="fr-form-control"
                           placeholder="Mínimo 8 caracteres" />
                    <small style="color:var(--fr-text-muted)">
                        Requisitos: 8+ caracteres, mayúscula, número, carácter especial
                    </small>
                </div>
                <div class="col-md-6">
                    <label class="fr-form-label">Confirmar contraseña *</label>
                    <input type="password" id="confirmarPassword" class="fr-form-control"
                           placeholder="Repita la contraseña" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid var(--fr-border)">
            <button type="button" class="fr-btn fr-btn-ghost" id="btnAnterior">
                <i class="ti ti-arrow-left"></i> Anterior
            </button>
            <button type="button" class="fr-btn fr-btn-primary" id="btnContinuar">
                Continuar <i class="ti ti-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Toggle de campos de contraseña
    document.getElementById('chkCambiarPassword')
        .addEventListener('change', (e) => {
            document.getElementById('seccionPassword').style.display =
                e.target.checked ? 'block' : 'none';
        });

    // Navegación
    document.getElementById('btnAnterior')
        .addEventListener('click', () => window.location.href = '/onboarding/paso/3');

    document.getElementById('btnContinuar').addEventListener('click', async () => {
        const nombre = document.getElementById('nombreCompleto').value.trim();
        if (!nombre) {
            FrToast.error('El nombre completo es obligatorio');
            return;
        }

        const cambiar = document.getElementById('chkCambiarPassword').checked;
        const nuevaPass = document.getElementById('nuevoPassword').value;
        const confirmar = document.getElementById('confirmarPassword').value;

        if (cambiar) {
            if (nuevaPass !== confirmar) {
                FrToast.error('Las contraseñas no coinciden');
                return;
            }
            if (nuevaPass.length < 8) {
                FrToast.error('La contraseña debe tener al menos 8 caracteres');
                return;
            }
            // Validar complejidad
            if (!/[A-Z]/.test(nuevaPass) || !/[0-9]/.test(nuevaPass) || !/[^A-Za-z0-9]/.test(nuevaPass)) {
                FrToast.error('La contraseña debe contener al menos una mayúscula, un número y un carácter especial');
                return;
            }
        }

        const btn = document.getElementById('btnContinuar');
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2 fr-spin"></i> Guardando...';

        const resp = await FrApi.post('/onboarding/paso/4/guardar', {
            nombreCompleto:  nombre,
            telefono:        document.getElementById('telefono').value.trim(),
            cambiarPassword: cambiar,
            nuevoPassword:   cambiar ? nuevaPass : null
        });

        if (resp?.success) {
            FrToast.success('Paso 4 guardado');
            setTimeout(() => window.location.href = '/onboarding/paso/5', 500);
        } else {
            FrToast.error(resp?.message || 'Error al guardar');
            btn.disabled = false;
            btn.innerHTML = 'Continuar <i class="ti ti-arrow-right"></i>';
        }
    });
</script>
}