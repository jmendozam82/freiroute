@{
    ViewData["Paso"] = 3;
    ViewData["Porcentaje"] = 60;
    Layout = "~/Areas/Onboarding/Views/_LayoutOnboarding.cshtml";
}

<div class="fr-card">
    <div class="fr-card-header">
        <span class="fr-card-title">Configuración operativa</span>
        <p style="margin-top:4px; font-size:13px; color:var(--fr-text-secondary)">
            Define cómo opera tu empresa de transporte
        </p>
    </div>
    <div class="fr-card-body">
        <!-- Configuración regional -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="fr-form-label">Moneda *</label>
                <select id="moneda" class="fr-form-control" required>
                    <option value="USD">USD — Dólar</option>
                    <option value="EUR">EUR — Euro</option>
                    <option value="GTQ">GTQ — Quetzal</option>
                    <option value="HNL">HNL — Lempira</option>
                    <option value="NIO">NIO — Córdoba</option>
                    <option value="CRC">CRC — Colón</option>
                    <option value="MXN">MXN — Peso Mexicano</option>
                    <option value="COP">COP — Peso Colombiano</option>
                    <option value="PEN">PEN — Sol Peruano</option>
                    <option value="CLP">CLP — Peso Chileno</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="fr-form-label">Zona horaria *</label>
                <select id="zonaHoraria" class="fr-form-control" required>
                    <option value="America/Managua">America/Managua</option>
                    <option value="America/Mexico_City">America/Mexico_City</option>
                    <option value="America/Bogota">America/Bogota</option>
                    <option value="America/Lima">America/Lima</option>
                    <option value="America/Santiago">America/Santiago</option>
                    <option value="America/Buenos_Aires">America/Buenos_Aires</option>
                    <option value="America/Sao_Paulo">America/Sao_Paulo</option>
                    <option value="UTC">UTC</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="fr-form-label">Formato de fecha *</label>
                <select id="formatoFecha" class="fr-form-control" required>
                    <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                    <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                    <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                </select>
            </div>
        </div>

        <!-- Modos de transporte -->
        <div class="mb-4">
            <label class="fr-form-label" style="margin-bottom:12px">
                Selecciona los modos de transporte que opera tu empresa *
            </label>
            <div class="row g-2" id="modosGrid">
                @{
                    var modos = new[] {
                        ("FTL",         "ti-truck",                 "FTL",         "Carga completa"),
                        ("LTL",         "ti-package",               "LTL",         "Carga parcial"),
                        ("AEREO",       "ti-plane",                 "Aéreo",       "Transporte aéreo"),
                        ("MARITIMO",    "ti-ship",                  "Marítimo",    "Transporte marítimo"),
                        ("FERROVIARIO", "ti-train",                 "Ferroviario", "Transporte ferroviario"),
                        ("INTERMODAL",  "ti-arrows-transfer-up",    "Intermodal",  "Transporte intermodal")
                    };
                }
                @foreach (var (codigo, icono, nombreCorto, descripcion) in modos)
                {
                    <div class="col-md-4 col-6">
                        <div class="modo-card" data-modo="@codigo" role="button"
                             aria-pressed="false" tabIndex="0">
                            <i class="ti @icono"></i>
                            <div class="modo-card-titulo">@nombreCorto</div>
                            <div class="modo-card-descripcion">@descripcion</div>
                        </div>
                    </div>
                }
            </div>
            <small style="color:var(--fr-text-muted)">
                <strong>Al menos 1 modo debe estar seleccionado.</strong>
            </small>
        </div>

        <!-- Numeración de documentos -->
        <div class="mb-0">
            <label class="fr-form-label" style="margin-bottom:12px">
                Numeración de documentos
            </label>
            <div class="row g-3">
                <div class="col-md-4">
                    <label style="font-size:11px; color:var(--fr-text-secondary)">
                        Prefijo embarques *
                    </label>
                    <input type="text" id="prefijoEmbarque" class="fr-form-control"
                           value="FR" pattern="[A-Z0-9]{2,10}" maxlength="10"
                           placeholder="FR" />
                    <small style="color:var(--fr-text-muted)">
                        Solo letras mayúsculas y números
                    </small>
                </div>
                <div class="col-md-4">
                    <label style="font-size:11px; color:var(--fr-text-secondary)">
                        Prefijo órdenes *
                    </label>
                    <input type="text" id="prefijoOrden" class="fr-form-control"
                           value="ORD" pattern="[A-Z0-9]{2,10}" maxlength="10"
                           placeholder="ORD" />
                    <small style="color:var(--fr-text-muted)">
                        Solo letras mayúsculas y números
                    </small>
                </div>
                <div class="col-md-4">
                    <label style="font-size:11px; color:var(--fr-text-secondary)">
                        Preview próximo número
                    </label>
                    <div id="previewNumero"
                         style="padding:8px 12px; background:var(--fr-surface-bg);
                                border:1px solid var(--fr-border); border-radius:6px;
                                font-family:'JetBrains Mono',monospace; font-size:13px;
                                color:var(--fr-text-primary); font-weight:600">
                        FR-@(DateTime.Now.Year)-00001
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid var(--fr-border)">
            <button type="button" class="fr-btn fr-btn-ghost" id="btnAnterior">
                <i class="ti ti-arrow-left"></i> Anterior
            </button>
            <button type="button" class="fr-btn fr-btn-primary" id="btnContinuar">
                Continuar <i class="ti ti-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Toggle visual de modo seleccionado (clase CSS .modo-activo)
    document.querySelectorAll('.modo-card').forEach(card => {
        const toggle = () => {
            const activo = card.classList.toggle('modo-activo');
            card.setAttribute('aria-pressed', activo ? 'true' : 'false');
        };
        card.addEventListener('click', toggle);
        card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggle();
            }
        });
    });

    // Preview del número al escribir el prefijo
    document.getElementById('prefijoEmbarque').addEventListener('input', (e) => {
        const val = e.target.value.toUpperCase();
        e.target.value = val;
        const anio = new Date().getFullYear();
        document.getElementById('previewNumero').textContent =
            `${val || 'FR'}-${anio}-00001`;
    });

    // Navegación
    document.getElementById('btnAnterior')
        .addEventListener('click', () => window.location.href = '/onboarding/paso/2');

    document.getElementById('btnContinuar').addEventListener('click', async () => {
        const modos = [...document.querySelectorAll('.modo-activo')]
            .map(c => c.dataset.modo);

        if (modos.length === 0) {
            FrToast.warning('Selecciona al menos un modo de transporte');
            return;
        }

        const prefijoEmb = document.getElementById('prefijoEmbarque').value.trim().toUpperCase();
        const prefijoOrd = document.getElementById('prefijoOrden').value.trim().toUpperCase();

        if (!prefijoEmb || prefijoEmb.length < 2) {
            FrToast.error('El prefijo de embarques debe tener al menos 2 caracteres');
            return;
        }
        if (!prefijoOrd || prefijoOrd.length < 2) {
            FrToast.error('El prefijo de órdenes debe tener al menos 2 caracteres');
            return;
        }

        const btn = document.getElementById('btnContinuar');
        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader-2 fr-spin"></i> Guardando...';

        const resp = await FrApi.post('/onboarding/paso/3/guardar', {
            modosTransporteActivos: modos,
            moneda:           document.getElementById('moneda').value,
            zonaHoraria:      document.getElementById('zonaHoraria').value,
            formatoFecha:     document.getElementById('formatoFecha').value,
            prefijoEmbarque:  prefijoEmb,
            prefijoOrden:     prefijoOrd
        });

        if (resp?.success) {
            FrToast.success('Paso 3 guardado');
            setTimeout(() => window.location.href = '/onboarding/paso/4', 500);
        } else {
            FrToast.error(resp?.message || 'Error al guardar');
            btn.disabled = false;
            btn.innerHTML = 'Continuar <i class="ti ti-arrow-right"></i>';
        }
    });
</script>
}